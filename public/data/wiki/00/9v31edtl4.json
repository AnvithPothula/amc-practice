/wiki/index.php?title=2025_AMC_10B_Problems/Problem_12\" title=\"2025 AMC 10B Problems/Problem 12\">12</a> <b>•</b> <a href=\"/wiki/index.php?title=2025_AMC_10B_Problems/Problem_13\" class=\"mw-redirect\" title=\"2025 AMC 10B Problems/Problem 13\">13</a> <b>•</b> <a href=\"/wiki/index.php?title=2025_AMC_10B_Problems/Problem_14\" class=\"mw-redirect\" title=\"2025 AMC 10B Problems/Problem 14\">14</a> <b>•</b> <a href=\"/wiki/index.php?title=2025_AMC_10B_Problems/Problem_15\" title=\"2025 AMC 10B Problems/Problem 15\">15</a> <b>•</b> <a href=\"/wiki/index.php?title=2025_AMC_10B_Problems/Problem_16\" title=\"2025 AMC 10B Problems/Problem 16\">16</a> <b>•</b> <a href=\"/wiki/index.php?title=2025_AMC_10B_Problems/Problem_17\" class=\"mw-redirect\" title=\"2025 AMC 10B Problems/Problem 17\">17</a> <b>•</b> <a href=\"/wiki/index.php?title=2025_AMC_10B_Problems/Problem_18\" title=\"2025 AMC 10B Problems/Problem 18\">18</a> <b>•</b> <a href=\"/wiki/index.php?title=2025_AMC_10B_Problems/Problem_19\" class=\"mw-redirect\" title=\"2025 AMC 10B Problems/Problem 19\">19</a> <b>•</b> <a href=\"/wiki/index.php?title=2025_AMC_10B_Problems/Problem_20\" title=\"2025 AMC 10B Problems/Problem 20\">20</a> <b>•</b> <a href=\"/wiki/index.php?title=2025_AMC_10B_Problems/Problem_21\" class=\"mw-redirect\" title=\"2025 AMC 10B Problems/Problem 21\">21</a> <b>•</b> <a href=\"/wiki/index.php?title=2025_AMC_10B_Problems/Problem_22\" title=\"2025 AMC 10B Problems/Problem 22\">22</a> <b>•</b> <a href=\"/wiki/index.php?title=2025_AMC_10B_Problems/Problem_23\" class=\"mw-redirect\" title=\"2025 AMC 10B Problems/Problem 23\">23</a> <b>•</b> <a href=\"/wiki/index.php?title=2025_AMC_10B_Problems/Problem_24\" class=\"mw-redirect\" title=\"2025 AMC 10B Problems/Problem 24\">24</a> <b>•</b> <a href=\"/wiki/index.php?title=2025_AMC_10B_Problems/Problem_25\" title=\"2025 AMC 10B Problems/Problem 25\">25</a>\n</td></tr>\n<tr>\n<td colspan=\"3\" style=\"text-align:center;\"><b><a href=\"/wiki/index.php?title=