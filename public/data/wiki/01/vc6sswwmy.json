lem 7\">7</a> <b>•</b> <a href=\"/wiki/index.php?title=2012_AMC_12A_Problems/Problem_8\" class=\"mw-redirect\" title=\"2012 AMC 12A Problems/Problem 8\">8</a> <b>•</b> <a href=\"/wiki/index.php?title=2012_AMC_12A_Problems/Problem_9\" class=\"mw-redirect\" title=\"2012 AMC 12A Problems/Problem 9\">9</a> <b>•</b> <a href=\"/wiki/index.php?title=2012_AMC_12A_Problems/Problem_10\" title=\"2012 AMC 12A Problems/Problem 10\">10</a> <b>•</b> <a href=\"/wiki/index.php?title=2012_AMC_12A_Problems/Problem_11\" title=\"2012 AMC 12A Problems/Problem 11\">11</a> <b>•</b> <a href=\"/wiki/index.php?title=2012_AMC_12A_Problems/Problem_12\" title=\"2012 AMC 12A Problems/Problem 12\">12</a> <b>•</b> <a href=\"/wiki/index.php?title=2012_AMC_12A_Problems/Problem_13\" class=\"mw-redirect\" title=\"2012 AMC 12A Problems/Problem 13\">13</a> <b>•</b> <a href=\"/wiki/index.php?title=2012_AMC_12A_Problems/Problem_14\" class=\"mw-redirect\" title=\"2012 AMC 12A Problems/Problem 14\">14</a> <b>•</b> <a href=\"/wiki/index.php?title=2012_AMC_12A_Problems/Problem_15\" class=\"mw-redirect\" title=\"2012 AMC 12A Problems/Problem 15\">15</a> <b>•</b> <a href=\"/wiki/index.php?title=2012_AMC_12A_Problems/Problem_16\" title=\"2012 AMC 12A Problems/Problem 16\">16</a> <b>•</b> <a href=\"/wiki/index.php?title=2012_AMC_12A_Problems/Problem_17\" title=\"2012 AMC 12A Problems/Problem 17\">17</a> <b>•</b> <a href=\"/wiki/index.php?title=2012_AMC_12A_Problems/Problem_18\" title=\"2012 AMC 12A Problems/Problem 18\">18</a> <b>•</b> <a href=\"/wiki/index.php?title=2012_AMC_12A_Problems/Problem_19\" class=\"mw-redirect\" title=\"2012 AMC 12A Problems/Problem 19\">19</a> <b>•</b> <a href=\"/wiki/index.php?title=2012_AMC_12A_Problems/Problem_20\" title=\"2012 AMC 12A Problems/Problem 20\">20</a> <b>•</b> <a href=\"/wiki/index.php?title=2012_AMC_12A_Problems/Problem_21\" class=\"mw-redirect\" title=\"2012 AMC 12A Problems/Problem 21\">21</a> <b>•</b> <a href=\"/wiki/index.php?title=2012_AMC_12A_Problems/Problem_22\