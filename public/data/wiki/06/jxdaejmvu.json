 <a href=\"/wiki/index.php?title=1970_AHSME_Problems/Problem_22\" title=\"1970 AHSME Problems/Problem 22\">22</a> <b>•</b> <a class=\"mw-selflink selflink\">23</a> <b>•</b> <a href=\"/wiki/index.php?title=1970_AHSME_Problems/Problem_24\" title=\"1970 AHSME Problems/Problem 24\">24</a> <b>•</b> <a href=\"/wiki/index.php?title=1970_AHSME_Problems/Problem_25\" title=\"1970 AHSME Problems/Problem 25\">25</a> <b>•</b> <a href=\"/wiki/index.php?title=1970_AHSME_Problems/Problem_26\" title=\"1970 AHSME Problems/Problem 26\">26</a> <b>•</b> <a href=\"/wiki/index.php?title=1970_AHSME_Problems/Problem_27\" title=\"1970 AHSME Problems/Problem 27\">27</a> <b>•</b> <a href=\"/wiki/index.php?title=1970_AHSME_Problems/Problem_28\" title=\"1970 AHSME Problems/Problem 28\">28</a> <b>•</b> <a href=\"/wiki/index.php?title=1970_AHSME_Problems/Problem_29\" title=\"1970 AHSME Problems/Problem 29\">29</a> <b>•</b> <a href=\"/wiki/index.php?title=1970_AHSME_Problems/Problem_30\" title=\"1970 AHSME Problems/Problem 30\">30</a> <b>•</b> <a href=\"/wiki/index.php?title=1970_AHSME_Problems/Problem_31\" title=\"1970 AHSME Problems/Problem 31\">31</a> <b>•</b> <a href=\"/wiki/index.php?title=1970_AHSME_Problems/Problem_32\" title=\"1970 AHSME Problems/Problem 32\">32</a> <b>•</b> <a href=\"/wiki/index.php?title=1970_AHSME_Problems/Problem_33\" title=\"1970 AHSME Problems/Problem 33\">33</a> <b>•</b> <a href=\"/wiki/index.php?title=1970_AHSME_Problems/Problem_34\" title=\"1970 AHSME Problems/Problem 34\">34</a> <b>•</b> <a href=\"/wiki/index.php?title=1970_AHSME_Problems/Problem_35\" title=\"1970 AHSME Problems/Problem 35\">35</a>\n</td></tr>\n<tr>\n<td align=\"center\" colspan=\"3\"><b><a href=\"/wiki/index.php?title=AHSME_Problems_and_Solutions\" title=\"AHSME Problems and Solutions\"> All AHSME Problems and Solutions</a></b>\n</td></tr></tbody></table>\n<div class=\"print\">\n<div style=\"display:flex;width:100%;justify-content:space-between;align-items:center\">\n<div>\n<p><span class=\"mw-de