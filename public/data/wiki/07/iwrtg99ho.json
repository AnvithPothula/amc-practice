_Problems/Problem_21\" title=\"2018 AMC 10B Problems/Problem 21\">21</a> <b>•</b> <a href=\"/wiki/index.php?title=2018_AMC_10B_Problems/Problem_22\" title=\"2018 AMC 10B Problems/Problem 22\">22</a> <b>•</b> <a href=\"/wiki/index.php?title=2018_AMC_10B_Problems/Problem_23\" title=\"2018 AMC 10B Problems/Problem 23\">23</a> <b>•</b> <a href=\"/wiki/index.php?title=2018_AMC_10B_Problems/Problem_24\" title=\"2018 AMC 10B Problems/Problem 24\">24</a> <b>•</b> <a href=\"/wiki/index.php?title=2018_AMC_10B_Problems/Problem_25\" title=\"2018 AMC 10B Problems/Problem 25\">25</a>\n</td></tr>\n<tr>\n<td colspan=\"3\" style=\"text-align:center;\"><b><a href=\"/wiki/index.php?title=AMC_10_Problems_and_Solutions\" title=\"AMC 10 Problems and Solutions\"> All AMC 10 Problems and Solutions</a></b>\n</td></tr></tbody></table>\n<table class=\"wikitable\" style=\"margin:0.5em auto; font-size:95%; border:1px solid black; width:80%;\">\n<tbody><tr>\n<td style=\"background:#ccf;text-align:center;\" colspan=\"2\"><b><a href=\"/wiki/index.php?title=2018_AMC_12B\" title=\"2018 AMC 12B\">2018 AMC 12B</a></b> (<b><a href=\"/wiki/index.php?title=2018_AMC_12B_Problems\" title=\"2018 AMC 12B Problems\">Problems</a></b> • <b><a href=\"/wiki/index.php?title=2018_AMC_12B_Answer_Key\" title=\"2018 AMC 12B Answer Key\">Answer Key</a></b> • <a rel=\"nofollow\" class=\"external text\" href=\"http://www.artofproblemsolving.com/community/c13\">Resources</a>)\n</td></tr>\n<tr>\n<td width=\"50%\" align=\"center\" rowspan=\"1\">Preceded&#160;by<br /><b><a href=\"/wiki/index.php?title=2018_AMC_12B_Problems/Problem_9\" title=\"2018 AMC 12B Problems/Problem 9\">Problem 9</a></b>\n</td>\n<td width=\"50%\" align=\"center\" rowspan=\"1\">Followed&#160;by<br /><b><a href=\"/wiki/index.php?title=2018_AMC_12B_Problems/Problem_11\" class=\"mw-redirect\" title=\"2018 AMC 12B Problems/Problem 11\">Problem 11</a></b>\n</td></tr>\n<tr>\n<td colspan=\"2\" style=\"text-align:center;\"><a href=\"/wiki/index.php?title=2018_A