href=\"/wiki/index.php?title=2010_AMC_12A_Problems/Problem_4\" title=\"2010 AMC 12A Problems/Problem 4\">4</a> <b>•</b> <a href=\"/wiki/index.php?title=2010_AMC_12A_Problems/Problem_5\" title=\"2010 AMC 12A Problems/Problem 5\">5</a> <b>•</b> <a href=\"/wiki/index.php?title=2010_AMC_12A_Problems/Problem_6\" title=\"2010 AMC 12A Problems/Problem 6\">6</a> <b>•</b> <a href=\"/wiki/index.php?title=2010_AMC_12A_Problems/Problem_7\" title=\"2010 AMC 12A Problems/Problem 7\">7</a> <b>•</b> <a href=\"/wiki/index.php?title=2010_AMC_12A_Problems/Problem_8\" title=\"2010 AMC 12A Problems/Problem 8\">8</a> <b>•</b> <a href=\"/wiki/index.php?title=2010_AMC_12A_Problems/Problem_9\" title=\"2010 AMC 12A Problems/Problem 9\">9</a> <b>•</b> <a href=\"/wiki/index.php?title=2010_AMC_12A_Problems/Problem_10\" title=\"2010 AMC 12A Problems/Problem 10\">10</a> <b>•</b> <a href=\"/wiki/index.php?title=2010_AMC_12A_Problems/Problem_11\" title=\"2010 AMC 12A Problems/Problem 11\">11</a> <b>•</b> <a href=\"/wiki/index.php?title=2010_AMC_12A_Problems/Problem_12\" title=\"2010 AMC 12A Problems/Problem 12\">12</a> <b>•</b> <a href=\"/wiki/index.php?title=2010_AMC_12A_Problems/Problem_13\" title=\"2010 AMC 12A Problems/Problem 13\">13</a> <b>•</b> <a class=\"mw-selflink selflink\">14</a> <b>•</b> <a href=\"/wiki/index.php?title=2010_AMC_12A_Problems/Problem_15\" title=\"2010 AMC 12A Problems/Problem 15\">15</a> <b>•</b> <a href=\"/wiki/index.php?title=2010_AMC_12A_Problems/Problem_16\" title=\"2010 AMC 12A Problems/Problem 16\">16</a> <b>•</b> <a href=\"/wiki/index.php?title=2010_AMC_12A_Problems/Problem_17\" title=\"2010 AMC 12A Problems/Problem 17\">17</a> <b>•</b> <a href=\"/wiki/index.php?title=2010_AMC_12A_Problems/Problem_18\" title=\"2010 AMC 12A Problems/Problem 18\">18</a> <b>•</b> <a href=\"/wiki/index.php?title=2010_AMC_12A_Problems/Problem_19\" title=\"2010 AMC 12A Problems/Problem 19\">19</a> <b>•</b> <a href=\"/wiki/index.php?title=2010_AMC_12A_Problems/Problem_20\" title=\"2010 AMC 12A Problems/Problem 20\">20</a> <b>•</b> <a href=\"/wiki/index.php?title=2010_AMC_12A_Problems/Problem_21\" title=\"2010 AMC 12A Problems/Problem 21\">21</a> <b>•</b> <a href=\"/wiki/index.php?title=2010_AMC_12A_Problems/Problem_22\" title=\"2010 AMC 12A Problems/Problem 22\">22</a> <b>•</b> <a href=\"/wiki/index.php?title=2010_AMC_12A_Problems/Problem_23\" title=\"2010 AMC 12A Problems/Problem 23\">23</a> <b>•</b> <a href=\"/wiki/index.php?title=2010_AMC_12A_Problems/Problem_24\" title=\"2010 AMC 12A Problems/Problem 24\">24</a> <b>•</b> <a href=\"/wiki/index.php?title=2010_AMC_12A_Problems/Problem_25\" title=\"2010 AMC 12A Problems/Problem 25\">25</a>\n</td></tr>\n<tr>\n<td colspan=\"2\" style=\"text-align:center;\"><b><a href=\"/wiki/index.php?title=AMC_12_Problems_and_Solutions\" title=\"AMC 12 Problems and Solutions\"> All AMC 12 Problems and Solutions</a></b>\n</td></tr></tbody></table>\n<div class=\"print\">\n<div style=\"display:flex;width:100%;justify-content:space-between;align-items:center\">\n<div>\n<p><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"/wiki/index.php?title=File:AMC_Logo.png\" class=\"mw-file-description\"><img src=\"https://artofproblemsolving.com/wiki/images/d/d1/AMC_Logo.png\" decoding=\"async\" width=\"97\" height=\"84\" class=\"mw-file-element\" /></a></span>\n</p>\n</div>\n<div style=\"flex-grow:1;text-align:right\">\n<p>These problems are copyrighted &#169; by the <a rel=\"nofollow\" class=\"external text\" href=\"https://www.maa.org\">Mathematical Association of America</a>. \n</p>\n</div>\n<div style=\"clear:both;\"></div>\n</div></div>\n<!-- \nNewPP limit report\nCached time: 20261017145417\nCache expiry: 86400\nReduced expiry: false\nComplications: [show‐toc]\nCPU time usage: 0.053 seconds\nReal time usage: 0.081 seconds\nPreprocessor visited node count: 320/1000000\nPost‐expand include size: 4458/2097152 bytes\nTemplate argument size: 405/2097152 bytes\nHighest expansion depth: 3/100\nExpensive parser function c