tle=\"2006 iTest Problems/Problem 23\">23</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_iTest_Problems/Problem_24\" title=\"2006 iTest Problems/Problem 24\">24</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_iTest_Problems/Problem_25\" title=\"2006 iTest Problems/Problem 25\">25</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_iTest_Problems/Problem_26\" title=\"2006 iTest Problems/Problem 26\">26</a> <b>•</b> <a class=\"mw-selflink selflink\">27</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_iTest_Problems/Problem_28\" title=\"2006 iTest Problems/Problem 28\">28</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_iTest_Problems/Problem_29\" title=\"2006 iTest Problems/Problem 29\">29</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_iTest_Problems/Problem_30\" title=\"2006 iTest Problems/Problem 30\">30</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_iTest_Problems/Problem_31\" title=\"2006 iTest Problems/Problem 31\">31</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_iTest_Problems/Problem_32\" title=\"2006 iTest Problems/Problem 32\">32</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_iTest_Problems/Problem_33\" title=\"2006 iTest Problems/Problem 33\">33</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_iTest_Problems/Problem_34\" title=\"2006 iTest Problems/Problem 34\">34</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_iTest_Problems/Problem_35\" title=\"2006 iTest Problems/Problem 35\">35</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_iTest_Problems/Problem_36\" title=\"2006 iTest Problems/Problem 36\">36</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_iTest_Problems/Problem_37\" title=\"2006 iTest Problems/Problem 37\">37</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_iTest_Problems/Problem_38\" title=\"2006 iTest Problems/Problem 38\">38</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_iTest_Problems/Problem_39&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"2006 iTest Problems/Problem 39 (page does not exist)\">39</a> <b>•</b>