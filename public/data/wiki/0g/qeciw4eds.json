em 10\">10</a> <b>•</b> <a href=\"/wiki/index.php?title=2022_AMC_12A_Problems/Problem_11\" title=\"2022 AMC 12A Problems/Problem 11\">11</a> <b>•</b> <a href=\"/wiki/index.php?title=2022_AMC_12A_Problems/Problem_12\" title=\"2022 AMC 12A Problems/Problem 12\">12</a> <b>•</b> <a class=\"mw-selflink selflink\">13</a> <b>•</b> <a href=\"/wiki/index.php?title=2022_AMC_12A_Problems/Problem_14\" title=\"2022 AMC 12A Problems/Problem 14\">14</a> <b>•</b> <a href=\"/wiki/index.php?title=2022_AMC_12A_Problems/Problem_15\" class=\"mw-redirect\" title=\"2022 AMC 12A Problems/Problem 15\">15</a> <b>•</b> <a href=\"/wiki/index.php?title=2022_AMC_12A_Problems/Problem_16\" title=\"2022 AMC 12A Problems/Problem 16\">16</a> <b>•</b> <a href=\"/wiki/index.php?title=2022_AMC_12A_Problems/Problem_17\" title=\"2022 AMC 12A Problems/Problem 17\">17</a> <b>•</b> <a href=\"/wiki/index.php?title=2022_AMC_12A_Problems/Problem_18\" class=\"mw-redirect\" title=\"2022 AMC 12A Problems/Problem 18\">18</a> <b>•</b> <a href=\"/wiki/index.php?title=2022_AMC_12A_Problems/Problem_19\" class=\"mw-redirect\" title=\"2022 AMC 12A Problems/Problem 19\">19</a> <b>•</b> <a href=\"/wiki/index.php?title=2022_AMC_12A_Problems/Problem_20\" class=\"mw-redirect\" title=\"2022 AMC 12A Problems/Problem 20\">20</a> <b>•</b> <a href=\"/wiki/index.php?title=2022_AMC_12A_Problems/Problem_21\" title=\"2022 AMC 12A Problems/Problem 21\">21</a> <b>•</b> <a href=\"/wiki/index.php?title=2022_AMC_12A_Problems/Problem_22\" title=\"2022 AMC 12A Problems/Problem 22\">22</a> <b>•</b> <a href=\"/wiki/index.php?title=2022_AMC_12A_Problems/Problem_23\" title=\"2022 AMC 12A Problems/Problem 23\">23</a> <b>•</b> <a href=\"/wiki/index.php?title=2022_AMC_12A_Problems/Problem_24\" class=\"mw-redirect\" title=\"2022 AMC 12A Problems/Problem 24\">24</a> <b>•</b> <a href=\"/wiki/index.php?title=2022_AMC_12A_Problems/Problem_25\" title=\"2022 AMC 12A Problems/Problem 25\">25</a>\n</td></tr>\n<tr>\n<td colspan=\"2\" style=\"text-align:cente