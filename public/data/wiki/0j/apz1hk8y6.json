lt=\"$\\Sigma$\" width=\"12\" height=\"12\" />\n</td>\n<td><img src=\"//latex.artofproblemsolving.com/f/a/3/fa35d9fc104207e09a712110ac81612c5b279a6c.png\" class=\"latex\" alt=\"$\\sigma$\" width=\"10\" height=\"8\" />\n</td>\n<td>Sigma\n</td></tr>\n<tr>\n<td>T\n</td>\n<td><img src=\"//latex.artofproblemsolving.com/1/d/c/1dc1c0119a604b91be9142370dc3159b6a9bbcb9.png\" class=\"latex\" alt=\"$\\tau$\" width=\"9\" height=\"8\" />\n</td>\n<td>Tau\n</td></tr>\n<tr>\n<td>Y\n</td>\n<td><img src=\"//latex.artofproblemsolving.com/f/a/6/fa63107e1a21cb3276476c4b1aeffda667c6d6e8.png\" class=\"latex\" alt=\"$\\upsilon$\" width=\"10\" height=\"8\" />\n</td>\n<td>Upsilon\n</td></tr>\n<tr>\n<td><img src=\"//latex.artofproblemsolving.com/b/8/5/b85bbfb165b853d6f5f9734be4cdabbb453f4e43.png\" class=\"latex\" alt=\"$\\Phi$\" style=\"vertical-align: 0px\" width=\"12\" height=\"13\" />\n</td>\n<td><img src=\"//latex.artofproblemsolving.com/2/c/1/2c175f60eecef1de7560c3bdea495d69f26f719d.png\" class=\"latex\" alt=\"$\\phi$\" style=\"vertical-align: -4px\" width=\"13\" height=\"18\" />\n</td>\n<td>Phi\n</td></tr>\n<tr>\n<td>X\n</td>\n<td><img src=\"//latex.artofproblemsolving.com/6/d/c/6dcb9b88aaa5f14312835145edf06fb2d0823c29.png\" class=\"latex\" alt=\"$\\chi$\" style=\"vertical-align: -3px\" width=\"11\" height=\"11\" />\n</td>\n<td>Chi\n</td></tr>\n<tr>\n<td><img src=\"//latex.artofproblemsolving.com/8/6/6/866f0204648be9ca6b10e14dd72295295dd53a79.png\" class=\"latex\" alt=\"$\\Psi$\" style=\"vertical-align: 0px\" width=\"13\" height=\"13\" />\n</td>\n<td><img src=\"//latex.artofproblemsolving.com/8/a/d/8ada738001410f131563551fb68731e4f302048d.png\" class=\"latex\" alt=\"$\\psi$\" style=\"vertical-align: -3px\" width=\"12\" height=\"16\" />\n</td>\n<td>Psi\n</td></tr>\n<tr>\n<td><img src=\"//latex.artofproblemsolving.com/9/e/2/9e2b196e9b7e57d1ec99f6534c581ea9759d2170.png\" class=\"latex\" alt=\"$\\Omega$\" width=\"12\" height=\"13\" />\n</td>\n<td><img src=\"//latex.artofproblemsolving.com/5