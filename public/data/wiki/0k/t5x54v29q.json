_Problems/Problem_52\" title=\"2007 iTest Problems/Problem 52\">52</a> <b>•</b> <a href=\"/wiki/index.php?title=2007_iTest_Problems/Problem_53\" title=\"2007 iTest Problems/Problem 53\">53</a> <b>•</b> <a href=\"/wiki/index.php?title=2007_iTest_Problems/Problem_54\" title=\"2007 iTest Problems/Problem 54\">54</a> <b>•</b> <a href=\"/wiki/index.php?title=2007_iTest_Problems/Problem_55\" title=\"2007 iTest Problems/Problem 55\">55</a> <b>•</b> <a href=\"/wiki/index.php?title=2007_iTest_Problems/Problem_56\" title=\"2007 iTest Problems/Problem 56\">56</a> <b>•</b> <a href=\"/wiki/index.php?title=2007_iTest_Problems/Problem_57\" title=\"2007 iTest Problems/Problem 57\">57</a> <b>•</b> <a href=\"/wiki/index.php?title=2007_iTest_Problems/Problem_58\" title=\"2007 iTest Problems/Problem 58\">58</a> <b>•</b> <a href=\"/wiki/index.php?title=2007_iTest_Problems/Problem_59\" title=\"2007 iTest Problems/Problem 59\">59</a> <b>•</b> <a href=\"/wiki/index.php?title=2007_iTest_Problems/Problem_60\" title=\"2007 iTest Problems/Problem 60\">60</a> <b>•</b> <a href=\"/wiki/index.php?title=2007_iTest_Problems/Problem_TB1\" title=\"2007 iTest Problems/Problem TB1\">TB1</a> <b>•</b> <a href=\"/wiki/index.php?title=2007_iTest_Problems/Problem_TB2\" title=\"2007 iTest Problems/Problem TB2\">TB2</a> <b>•</b> <a href=\"/wiki/index.php?title=2007_iTest_Problems/Problem_TB3\" title=\"2007 iTest Problems/Problem TB3\">TB3</a> <b>•</b> <a href=\"/wiki/index.php?title=2007_iTest_Problems/Problem_TB4\" title=\"2007 iTest Problems/Problem TB4\">TB4</a>\n</td></tr></tbody></table>\n\n<!-- \nNewPP limit report\nCached time: 20261017214259\nCache expiry: 86400\nReduced expiry: false\nComplications: []\nCPU time usage: 0.040 seconds\nReal time usage: 0.053 seconds\nPreprocessor visited node count: 257/1000000\nPost‐expand include size: 3560/2097152 bytes\nTemplate argument size: 284/2097152 bytes\nHighest expansion depth: 3/100\nExpensive parser function count: 0/100\nUnstrip recursion depth: 0/20\nUn