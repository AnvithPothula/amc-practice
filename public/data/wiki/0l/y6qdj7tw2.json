" title=\"2008 iTest Problems/Problem 19\">19</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_20\" title=\"2008 iTest Problems/Problem 20\">20</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_21\" title=\"2008 iTest Problems/Problem 21\">21</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_22\" title=\"2008 iTest Problems/Problem 22\">22</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_23\" title=\"2008 iTest Problems/Problem 23\">23</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_24\" title=\"2008 iTest Problems/Problem 24\">24</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_25\" title=\"2008 iTest Problems/Problem 25\">25</a> <b>•</b> <a class=\"mw-selflink selflink\">26</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_27\" title=\"2008 iTest Problems/Problem 27\">27</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_28\" title=\"2008 iTest Problems/Problem 28\">28</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_29\" title=\"2008 iTest Problems/Problem 29\">29</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_30\" title=\"2008 iTest Problems/Problem 30\">30</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_31\" title=\"2008 iTest Problems/Problem 31\">31</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_32\" title=\"2008 iTest Problems/Problem 32\">32</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_33\" title=\"2008 iTest Problems/Problem 33\">33</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_34\" title=\"2008 iTest Problems/Problem 34\">34</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_35\" title=\"2008 iTest Problems/Problem 35\">35</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_36\" title=\"2008 iTest Problems/Problem 36\">36</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_37\" title=\"2008 iTest Problems/Problem 37\">37</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_38\" title=\"2008 iTest Problems/Problem 38\">38</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_39\" title=\"2008 iTest Problems/Problem 39\">39</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_40\" title=\"2008 iTest Problems/Problem 40\">40</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_41\" title=\"2008 iTest Problems/Problem 41\">41</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_42\" title=\"2008 iTest Problems/Problem 42\">42</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_43\" title=\"2008 iTest Problems/Problem 43\">43</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_44\" title=\"2008 iTest Problems/Problem 44\">44</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_45\" title=\"2008 iTest Problems/Problem 45\">45</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_46\" title=\"2008 iTest Problems/Problem 46\">46</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_47\" title=\"2008 iTest Problems/Problem 47\">47</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_48\" title=\"2008 iTest Problems/Problem 48\">48</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_49\" title=\"2008 iTest Problems/Problem 49\">49</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_50\" title=\"2008 iTest Problems/Problem 50\">50</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_51\" title=\"2008 iTest Problems/Problem 51\">51</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_52\" title=\"2008 iTest Problems/Problem 52\">52<