i/index.php?title=2008_AMC_12A_Problems/Problem_22\" title=\"2008 AMC 12A Problems/Problem 22\">22</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_AMC_12A_Problems/Problem_23\" title=\"2008 AMC 12A Problems/Problem 23\">23</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_AMC_12A_Problems/Problem_24\" title=\"2008 AMC 12A Problems/Problem 24\">24</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_AMC_12A_Problems/Problem_25\" title=\"2008 AMC 12A Problems/Problem 25\">25</a>\n</td></tr>\n<tr>\n<td colspan=\"2\" style=\"text-align:center;\"><b><a href=\"/wiki/index.php?title=AMC_12_Problems_and_Solutions\" title=\"AMC 12 Problems and Solutions\"> All AMC 12 Problems and Solutions</a></b>\n</td></tr></tbody></table>\n<table class=\"wikitable\" style=\"margin:0.5em auto; font-size:95%; border:1px solid black; width:80%;\">\n<tbody><tr>\n<td style=\"background:#ccf;text-align:center;\" colspan=\"3\"><b><a href=\"/wiki/index.php?title=2008_AMC_10A\" title=\"2008 AMC 10A\">2008 AMC 10A</a></b> (<b><a href=\"/wiki/index.php?title=2008_AMC_10A_Problems\" title=\"2008 AMC 10A Problems\">Problems</a></b> • <b><a href=\"/wiki/index.php?title=2008_AMC_10A_Answer_Key\" title=\"2008 AMC 10A Answer Key\">Answer Key</a></b> • <a rel=\"nofollow\" class=\"external text\" href=\"https://artofproblemsolving.com/community/c13\">Resources</a>)\n</td></tr>\n<tr>\n<td width=\"50%\" align=\"center\" rowspan=\"1\">Preceded&#160;by<br /><b><a href=\"/wiki/index.php?title=2008_AMC_10A_Problems/Problem_10\" title=\"2008 AMC 10A Problems/Problem 10\">Problem 10</a></b>\n</td>\n<td width=\"50%\" align=\"center\" rowspan=\"1\">Followed&#160;by<br /><b><a href=\"/wiki/index.php?title=2008_AMC_10A_Problems/Problem_12\" title=\"2008 AMC 10A Problems/Problem 12\">Problem 12</a></b>\n</td></tr>\n<tr>\n<td colspan=\"3\" style=\"text-align:center;\"><a href=\"/wiki/index.php?title=2008_AMC_10A_Problems/Problem_1\" class=\"mw-redirect\" title=\"2008 AMC 10A Problems/Problem 1\">1</a> <b>•</b> <a href=\"/