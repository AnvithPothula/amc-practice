\" title=\"1996 AJHSME Problems/Problem 14\">14</a> <b>•</b> <a href=\"/wiki/index.php?title=1996_AJHSME_Problems/Problem_15\" title=\"1996 AJHSME Problems/Problem 15\">15</a> <b>•</b> <a href=\"/wiki/index.php?title=1996_AJHSME_Problems/Problem_16\" title=\"1996 AJHSME Problems/Problem 16\">16</a> <b>•</b> <a href=\"/wiki/index.php?title=1996_AJHSME_Problems/Problem_17\" title=\"1996 AJHSME Problems/Problem 17\">17</a> <b>•</b> <a href=\"/wiki/index.php?title=1996_AJHSME_Problems/Problem_18\" title=\"1996 AJHSME Problems/Problem 18\">18</a> <b>•</b> <a href=\"/wiki/index.php?title=1996_AJHSME_Problems/Problem_19\" title=\"1996 AJHSME Problems/Problem 19\">19</a> <b>•</b> <a href=\"/wiki/index.php?title=1996_AJHSME_Problems/Problem_20\" title=\"1996 AJHSME Problems/Problem 20\">20</a> <b>•</b> <a class=\"mw-selflink selflink\">21</a> <b>•</b> <a href=\"/wiki/index.php?title=1996_AJHSME_Problems/Problem_22\" title=\"1996 AJHSME Problems/Problem 22\">22</a> <b>•</b> <a href=\"/wiki/index.php?title=1996_AJHSME_Problems/Problem_23\" title=\"1996 AJHSME Problems/Problem 23\">23</a> <b>•</b> <a href=\"/wiki/index.php?title=1996_AJHSME_Problems/Problem_24\" title=\"1996 AJHSME Problems/Problem 24\">24</a> <b>•</b> <a href=\"/wiki/index.php?title=1996_AJHSME_Problems/Problem_25\" title=\"1996 AJHSME Problems/Problem 25\">25</a>\n</td></tr>\n<tr>\n<td colspan=\"3\" style=\"text-align:center;\"><b><a href=\"/wiki/index.php?title=AMC_8_Problems_and_Solutions\" title=\"AMC 8 Problems and Solutions\"> All AJHSME/AMC 8 Problems and Solutions</a></b>\n</td></tr></tbody></table>\n<ul><li><a href=\"/wiki/index.php?title=AJHSME\" class=\"mw-redirect\" title=\"AJHSME\">AJHSME</a></li>\n<li><a href=\"/wiki/index.php?title=AJHSME_Problems_and_Solutions\" class=\"mw-redirect\" title=\"AJHSME Problems and Solutions\">AJHSME Problems and Solutions</a></li>\n<li><a href=\"/wiki/index.php?title=Mathematics_competition_resources\" class=\"mw-redirect\" title=\"Mathematics competition resource