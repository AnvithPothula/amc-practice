p?title=2002_AMC_12A_Problems/Problem_23\" title=\"2002 AMC 12A Problems/Problem 23\">23</a> <b>•</b> <a href=\"/wiki/index.php?title=2002_AMC_12A_Problems/Problem_24\" title=\"2002 AMC 12A Problems/Problem 24\">24</a> <b>•</b> <a href=\"/wiki/index.php?title=2002_AMC_12A_Problems/Problem_25\" title=\"2002 AMC 12A Problems/Problem 25\">25</a>\n</td></tr>\n<tr>\n<td colspan=\"2\" style=\"text-align:center;\"><b><a href=\"/wiki/index.php?title=AMC_12_Problems_and_Solutions\" title=\"AMC 12 Problems and Solutions\"> All AMC 12 Problems and Solutions</a></b>\n</td></tr></tbody></table>\n<table class=\"wikitable\" style=\"margin:0.5em auto; font-size:95%; border:1px solid black; width:80%;\">\n<tbody><tr>\n<td style=\"background:#ccf;text-align:center;\" colspan=\"3\"><b><a href=\"/wiki/index.php?title=2002_AMC_10A\" title=\"2002 AMC 10A\">2002 AMC 10A</a></b> (<b><a href=\"/wiki/index.php?title=2002_AMC_10A_Problems\" title=\"2002 AMC 10A Problems\">Problems</a></b> • <b><a href=\"/wiki/index.php?title=2002_AMC_10A_Answer_Key\" title=\"2002 AMC 10A Answer Key\">Answer Key</a></b> • <a rel=\"nofollow\" class=\"external text\" href=\"https://artofproblemsolving.com/community/c13\">Resources</a>)\n</td></tr>\n<tr>\n<td width=\"50%\" align=\"center\" rowspan=\"1\">Preceded&#160;by<br /><b><a href=\"/wiki/index.php?title=2002_AMC_10A_Problems/Problem_10\" class=\"mw-redirect\" title=\"2002 AMC 10A Problems/Problem 10\">Problem 10</a></b>\n</td>\n<td width=\"50%\" align=\"center\" rowspan=\"1\">Followed&#160;by<br /><b><a href=\"/wiki/index.php?title=2002_AMC_10A_Problems/Problem_12\" class=\"mw-redirect\" title=\"2002 AMC 10A Problems/Problem 12\">Problem 12</a></b>\n</td></tr>\n<tr>\n<td colspan=\"3\" style=\"text-align:center;\"><a href=\"/wiki/index.php?title=2002_AMC_10A_Problems/Problem_1\" title=\"2002 AMC 10A Problems/Problem 1\">1</a> <b>•</b> <a href=\"/wiki/index.php?title=2002_AMC_10A_Problems/Problem_2\" title=\"2002 AMC 10A Problems/Problem 2\">2</a> <b>•</b> <a href=\"/wiki/index.php?title=2002_AMC_10A_Problems/Problem_3\" class=\"mw-redirect\" title=\"2002 AMC 10A Problems/Problem 3\">3</a> <b>•</b> <a href=\"/wiki/index.php?title=2002_AMC_10A_Problems/Problem_4\" class=\"mw-redirect\" title=\"2002 AMC 10A Problems/Problem 4\">4</a> <b>•</b> <a href=\"/wiki/index.php?title=2002_AMC_10A_Problems/Problem_5\" class=\"mw-redirect\" title=\"2002 AMC 10A Problems/Problem 5\">5</a> <b>•</b> <a href=\"/wiki/index.php?title=2002_AMC_10A_Problems/Problem_6\" class=\"mw-redirect\" title=\"2002 AMC 10A Problems/Problem 6\">6</a> <b>•</b> <a href=\"/wiki/index.php?title=2002_AMC_10A_Problems/Problem_7\" class=\"mw-redirect\" title=\"2002 AMC 10A Problems/Problem 7\">7</a> <b>•</b> <a href=\"/wiki/index.php?title=2002_AMC_10A_Problems/Problem_8\" class=\"mw-redirect\" title=\"2002 AMC 10A Problems/Problem 8\">8</a> <b>•</b> <a href=\"/wiki/index.php?title=2002_AMC_10A_Problems/Problem_9\" title=\"2002 AMC 10A Problems/Problem 9\">9</a> <b>•</b> <a href=\"/wiki/index.php?title=2002_AMC_10A_Problems/Problem_10\" class=\"mw-redirect\" title=\"2002 AMC 10A Problems/Problem 10\">10</a> <b>•</b> <a href=\"/wiki/index.php?title=2002_AMC_10A_Problems/Problem_11\" class=\"mw-redirect\" title=\"2002 AMC 10A Problems/Problem 11\">11</a> <b>•</b> <a href=\"/wiki/index.php?title=2002_AMC_10A_Problems/Problem_12\" class=\"mw-redirect\" title=\"2002 AMC 10A Problems/Problem 12\">12</a> <b>•</b> <a href=\"/wiki/index.php?title=2002_AMC_10A_Problems/Problem_13\" title=\"2002 AMC 10A Problems/Problem 13\">13</a> <b>•</b> <a href=\"/wiki/index.php?title=2002_AMC_10A_Problems/Problem_14\" class=\"mw-redirect\" title=\"2002 AMC 10A Problems/Problem 14\">14</a> <b>•</b> <a href=\"/wiki/index.php?title=2002_AMC_10A_Problems/Problem_15\" title=\"2002 AMC 10A Problems/Problem 15\">15</a> <b>•</b> <a href=\"/wiki/index.php?title=2002_AMC_10A_Problems/Problem_16\" title=\"2002 AMC 10A Problems/Problem 16\">16</a> <b>•</b> <a href=\"/wiki/index.php?title=2002_AMC_10A_Problems/Problem_17\" class=\"mw-redirect\" title=\"2002 AMC 10A Problems/Problem 17\">17</a> <b>•</b> <a href=\"/wiki/index.php?title=2002_AMC_10A_Problems/Problem_18\" title=\"2002 AMC 10A Problems/Problem 18\">18</a> <b>•</b> <a href=\"/wiki/index.php?title=2002_AMC_10A_Problems/Problem_19\" title=\"2002 AMC 10A Problems/Problem 19\">19</a> <b>•</b> <a href=\"/wiki/index.php?title=2002_AMC_10A_Problems/Problem_20\" title=\"2002 AMC 10A Problems/Problem 20\">20</a> <b>•</b> <a href=\"/wiki/index.php?title=2002_AMC_10A_Problems/Problem_21\" class=\"mw-redirect\" title=\"2002 AMC 10A Problems/Problem 21\">21</a> <b>•</b> <a href=\"/wiki/index.php?title=2002_AMC_10A_Problems/Problem_22\" title=\"2002 AMC 10A Problems/Problem 22\">22</a> <b>•</b> <a href=\"/wiki/index.php?title=2002_AMC_10A_Problems/Problem_23\" title=\"2002 AMC 10A Problems/Problem 23\">23</a> <b>•</b> <a href=\"/wiki/index.php?title=2002_AMC_10A_Problems/Problem_24\" class=\"mw-redirect\" title=\"2002 AMC 10A Problems/Problem 24\">24</a> <b>•</b> <a href=\"/wiki/index.php?title=2002_AMC_10A_Problems/Problem_25\" title=\"2002 AMC 10A Problems/Problem 25\">25</a>\n</td></tr>\n<tr>\n<td colspan=\"3\" style=\"text-align:center;\"><b><a href=\"/wiki/index.php?title=AMC_10_Problems_and_Solutions\" title=\"AMC 10 Problems and Solutions\"> All AMC 10 Problems and Solutions</a></b>\n</td></tr></tbody></table>\n<div class=\"print\">\n<div style=\"display:flex;width:100%;justify-content:space-between;align-items:center\">\n<div>\n<p><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"/wiki/index.php?title=File:AMC_Logo.png\" class=\"mw-file-description\"><img src=\"https://artofproblemsolving.com/wiki/images/d/d1/AMC_Logo.png\" decoding=\"async\" width=\"97\" height=\"84\" class=\"mw-file-element\" /></a></span>\n</p>\n</div>\n<div style=\"flex-grow:1;text-align:right\">\n<p>These problems are copyrighted &#169; by the <a rel=\"nofollow\" class=\"external text\" href=\"https://www.maa.org\">Math