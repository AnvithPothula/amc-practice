/a> <b>•</b> <a href=\"/wiki/index.php?title=1973_AHSME_Problems/Problem_20\" title=\"1973 AHSME Problems/Problem 20\">20</a> <b>•</b> <a href=\"/wiki/index.php?title=1973_AHSME_Problems/Problem_21\" title=\"1973 AHSME Problems/Problem 21\">21</a> <b>•</b> <a href=\"/wiki/index.php?title=1973_AHSME_Problems/Problem_22\" title=\"1973 AHSME Problems/Problem 22\">22</a> <b>•</b> <a href=\"/wiki/index.php?title=1973_AHSME_Problems/Problem_23\" title=\"1973 AHSME Problems/Problem 23\">23</a> <b>•</b> <a href=\"/wiki/index.php?title=1973_AHSME_Problems/Problem_24\" title=\"1973 AHSME Problems/Problem 24\">24</a> <b>•</b> <a href=\"/wiki/index.php?title=1973_AHSME_Problems/Problem_25\" title=\"1973 AHSME Problems/Problem 25\">25</a> <b>•</b> <a href=\"/wiki/index.php?title=1973_AHSME_Problems/Problem_26\" title=\"1973 AHSME Problems/Problem 26\">26</a> <b>•</b> <a href=\"/wiki/index.php?title=1973_AHSME_Problems/Problem_27\" title=\"1973 AHSME Problems/Problem 27\">27</a> <b>•</b> <a href=\"/wiki/index.php?title=1973_AHSME_Problems/Problem_28\" title=\"1973 AHSME Problems/Problem 28\">28</a> <b>•</b> <a href=\"/wiki/index.php?title=1973_AHSME_Problems/Problem_29\" title=\"1973 AHSME Problems/Problem 29\">29</a> <b>•</b> <a href=\"/wiki/index.php?title=1973_AHSME_Problems/Problem_30\" title=\"1973 AHSME Problems/Problem 30\">30</a> <b>•</b> <a href=\"/wiki/index.php?title=1973_AHSME_Problems/Problem_31\" title=\"1973 AHSME Problems/Problem 31\">31</a> <b>•</b> <a href=\"/wiki/index.php?title=1973_AHSME_Problems/Problem_32\" title=\"1973 AHSME Problems/Problem 32\">32</a> <b>•</b> <a href=\"/wiki/index.php?title=1973_AHSME_Problems/Problem_33\" title=\"1973 AHSME Problems/Problem 33\">33</a> <b>•</b> <a href=\"/wiki/index.php?title=1973_AHSME_Problems/Problem_34\" title=\"1973 AHSME Problems/Problem 34\">34</a> <b>•</b> <a href=\"/wiki/index.php?title=1973_AHSME_Problems/Problem_35\" title=\"1973 AHSME Problems/Problem 35\">35</a>\n</td></tr>\n<tr>\n<td align=\"center\" cols