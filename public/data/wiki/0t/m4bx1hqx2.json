blem_17\" title=\"1960 AHSME Problems/Problem 17\">17</a> <b>•</b> <a href=\"/wiki/index.php?title=1960_AHSME_Problems/Problem_18\" title=\"1960 AHSME Problems/Problem 18\">18</a> <b>•</b> <a href=\"/wiki/index.php?title=1960_AHSME_Problems/Problem_19\" title=\"1960 AHSME Problems/Problem 19\">19</a> <b>•</b> <a href=\"/wiki/index.php?title=1960_AHSME_Problems/Problem_20\" title=\"1960 AHSME Problems/Problem 20\">20</a> <b>•</b> <a href=\"/wiki/index.php?title=1960_AHSME_Problems/Problem_21\" title=\"1960 AHSME Problems/Problem 21\">21</a> <b>•</b> <a href=\"/wiki/index.php?title=1960_AHSME_Problems/Problem_22\" title=\"1960 AHSME Problems/Problem 22\">22</a> <b>•</b> <a href=\"/wiki/index.php?title=1960_AHSME_Problems/Problem_23\" title=\"1960 AHSME Problems/Problem 23\">23</a> <b>•</b> <a href=\"/wiki/index.php?title=1960_AHSME_Problems/Problem_24\" title=\"1960 AHSME Problems/Problem 24\">24</a> <b>•</b> <a href=\"/wiki/index.php?title=1960_AHSME_Problems/Problem_25\" title=\"1960 AHSME Problems/Problem 25\">25</a> <b>•</b> <a href=\"/wiki/index.php?title=1960_AHSME_Problems/Problem_26\" title=\"1960 AHSME Problems/Problem 26\">26</a> <b>•</b> <a href=\"/wiki/index.php?title=1960_AHSME_Problems/Problem_27\" title=\"1960 AHSME Problems/Problem 27\">27</a> <b>•</b> <a href=\"/wiki/index.php?title=1960_AHSME_Problems/Problem_28\" title=\"1960 AHSME Problems/Problem 28\">28</a> <b>•</b> <a href=\"/wiki/index.php?title=1960_AHSME_Problems/Problem_29\" title=\"1960 AHSME Problems/Problem 29\">29</a> <b>•</b> <a href=\"/wiki/index.php?title=1960_AHSME_Problems/Problem_30\" title=\"1960 AHSME Problems/Problem 30\">30</a> <b>•</b> <a href=\"/wiki/index.php?title=1960_AHSME_Problems/Problem_31\" title=\"1960 AHSME Problems/Problem 31\">31</a> <b>•</b> <a href=\"/wiki/index.php?title=1960_AHSME_Problems/Problem_32\" title=\"1960 AHSME Problems/Problem 32\">32</a> <b>•</b> <a href=\"/wiki/index.php?title=1960_AHSME_Problems/Problem_33\" title=\"1960 AHSME Problems/Problem 33\">33</a> <b>•</b> <a href=\"/wiki/index.php?title=1960_AHSME_Problems/Problem_34\" title=\"1960 AHSME Problems/Problem 34\">34</a> <b>•</b> <a href=\"/wiki/index.php?title=1960_AHSME_Problems/Problem_35\" title=\"1960 AHSME Problems/Problem 35\">35</a> <b>•</b> <a href=\"/wiki/index.php?title=1960_AHSME_Problems/Problem_36\" title=\"1960 AHSME Problems/Problem 36\">36</a> <b>•</b> <a href=\"/wiki/index.php?title=1960_AHSME_Problems/Problem_37\" title=\"1960 AHSME Problems/Problem 37\">37</a> <b>•</b> <a href=\"/wiki/index.php?title=1960_AHSME_Problems/Problem_38\" title=\"1960 AHSME Problems/Problem 38\">38</a> <b>•</b> <a href=\"/wiki/index.php?title=1960_AHSME_Problems/Problem_39\" title=\"1960 AHSME Problems/Problem 39\">39</a> <b>•</b> <a href=\"/wiki/index.php?title=1960_AHSME_Problems/Problem_40\" title=\"1960 AHSME Problems/Problem 40\">40</a>\n</td></tr>\n<tr>\n<td align=\"center\" colspan=\"3\"><b><a href=\"/wiki/index.php?title=AHSME_Problems_and_Solutions\" title=\"AHSME Problems and Solutions\"> All AHSME Problems and Solutions</a></b>\n</td></tr></tbody></table>\n<!-- \nNewPP limit report\nCached time: 20261016232416\nCache expiry: 86400\nReduced expiry: false\nComplications: [show‐toc]\nCPU time usage: 0.034 seconds\nReal time usage: 0.049 seconds\nPreprocessor visited node count: 310/1000000\nPost‐expand include size: 2645/2097152 bytes\nTemplate argument size: 192/2097152 bytes\nHighest expansion depth: 3/100\nExpensive parser function count: 0/100\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 6582/5000000 bytes\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%    9.174      1 Template:AHSME_40p_box\n100.00%    9.174      1 -total\n-->\n\n<!-- Saved in parser cache with key wiki-wiki_:pcache:16231:|#|:idhash:canonical and timestamp 20261016232416 and revision id 94547. Rendering was triggered because: page-view\n -->\n</div>"}