2</a> <b>•</b> <a href=\"/wiki/index.php?title=2013_CEMC_Fermat_Problems/Problem_13&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"2013 CEMC Fermat Problems/Problem 13 (page does not exist)\">13</a> <b>•</b> <a href=\"/wiki/index.php?title=2013_CEMC_Fermat_Problems/Problem_14&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"2013 CEMC Fermat Problems/Problem 14 (page does not exist)\">14</a> <b>•</b> <a href=\"/wiki/index.php?title=2013_CEMC_Fermat_Problems/Problem_15&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"2013 CEMC Fermat Problems/Problem 15 (page does not exist)\">15</a> <b>•</b> <a href=\"/wiki/index.php?title=2013_CEMC_Fermat_Problems/Problem_16&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"2013 CEMC Fermat Problems/Problem 16 (page does not exist)\">16</a> <b>•</b> <a href=\"/wiki/index.php?title=2013_CEMC_Fermat_Problems/Problem_17&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"2013 CEMC Fermat Problems/Problem 17 (page does not exist)\">17</a> <b>•</b> <a href=\"/wiki/index.php?title=2013_CEMC_Fermat_Problems/Problem_18&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"2013 CEMC Fermat Problems/Problem 18 (page does not exist)\">18</a> <b>•</b> <a href=\"/wiki/index.php?title=2013_CEMC_Fermat_Problems/Problem_19&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"2013 CEMC Fermat Problems/Problem 19 (page does not exist)\">19</a> <b>•</b> <a href=\"/wiki/index.php?title=2013_CEMC_Fermat_Problems/Problem_20&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"2013 CEMC Fermat Problems/Problem 20 (page does not exist)\">20</a> <b>•</b> <a href=\"/wiki/index.php?title=2013_CEMC_Fermat_Problems/Problem_21&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"2013 CEMC Fermat Problems/Problem 21 (page does not exist)\">21</a> <b>•</b> <a href=\"/wiki/index.php?title=2013_CEMC_Fermat_Problems/Problem_22&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"2013 CEMC Fermat Problems/Problem 22 (page does not exist)\">2