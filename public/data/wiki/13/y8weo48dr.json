 <b>•</b> <a href=\"/wiki/index.php?title=1950_AHSME_Problems/Problem_23\" title=\"1950 AHSME Problems/Problem 23\">23</a> <b>•</b> <a href=\"/wiki/index.php?title=1950_AHSME_Problems/Problem_24\" title=\"1950 AHSME Problems/Problem 24\">24</a> <b>•</b> <a href=\"/wiki/index.php?title=1950_AHSME_Problems/Problem_25\" title=\"1950 AHSME Problems/Problem 25\">25</a> <b>•</b> <a class=\"mw-selflink selflink\">26</a> <b>•</b> <a href=\"/wiki/index.php?title=1950_AHSME_Problems/Problem_27\" title=\"1950 AHSME Problems/Problem 27\">27</a> <b>•</b> <a href=\"/wiki/index.php?title=1950_AHSME_Problems/Problem_28\" title=\"1950 AHSME Problems/Problem 28\">28</a> <b>•</b> <a href=\"/wiki/index.php?title=1950_AHSME_Problems/Problem_29\" title=\"1950 AHSME Problems/Problem 29\">29</a> <b>•</b> <a href=\"/wiki/index.php?title=1950_AHSME_Problems/Problem_30\" title=\"1950 AHSME Problems/Problem 30\">30</a> <b>•</b> <a href=\"/wiki/index.php?title=1950_AHSME_Problems/Problem_31\" title=\"1950 AHSME Problems/Problem 31\">31</a> <b>•</b> <a href=\"/wiki/index.php?title=1950_AHSME_Problems/Problem_32\" title=\"1950 AHSME Problems/Problem 32\">32</a> <b>•</b> <a href=\"/wiki/index.php?title=1950_AHSME_Problems/Problem_33\" title=\"1950 AHSME Problems/Problem 33\">33</a> <b>•</b> <a href=\"/wiki/index.php?title=1950_AHSME_Problems/Problem_34\" title=\"1950 AHSME Problems/Problem 34\">34</a> <b>•</b> <a href=\"/wiki/index.php?title=1950_AHSME_Problems/Problem_35\" title=\"1950 AHSME Problems/Problem 35\">35</a> <b>•</b> <a href=\"/wiki/index.php?title=1950_AHSME_Problems/Problem_36\" title=\"1950 AHSME Problems/Problem 36\">36</a> <b>•</b> <a href=\"/wiki/index.php?title=1950_AHSME_Problems/Problem_37\" title=\"1950 AHSME Problems/Problem 37\">37</a> <b>•</b> <a href=\"/wiki/index.php?title=1950_AHSME_Problems/Problem_38\" title=\"1950 AHSME Problems/Problem 38\">38</a> <b>•</b> <a href=\"/wiki/index.php?title=1950_AHSME_Problems/Problem_39\" title=\"1950 AHSME Problems/Problem 39\">39</