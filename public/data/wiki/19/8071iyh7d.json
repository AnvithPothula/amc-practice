b>•</b> <a href=\"/wiki/index.php?title=2001_AMC_12_Problems/Problem_23\" title=\"2001 AMC 12 Problems/Problem 23\">23</a> <b>•</b> <a href=\"/wiki/index.php?title=2001_AMC_12_Problems/Problem_24\" title=\"2001 AMC 12 Problems/Problem 24\">24</a> <b>•</b> <a href=\"/wiki/index.php?title=2001_AMC_12_Problems/Problem_25\" title=\"2001 AMC 12 Problems/Problem 25\">25</a>\n</td></tr>\n<tr>\n<td colspan=\"2\" style=\"text-align:center;\"><b><a href=\"/wiki/index.php?title=AMC_12_Problems_and_Solutions\" title=\"AMC 12 Problems and Solutions\"> All AMC 12 Problems and Solutions</a></b>\n</td></tr></tbody></table>\n<table class=\"wikitable\" style=\"margin:0.5em auto; font-size:95%; border:1px solid black; width:80%;\">\n<tbody><tr>\n<td style=\"background:#ccf;text-align:center;\" colspan=\"3\"><b><a href=\"/wiki/index.php?title=2001_AMC_10\" title=\"2001 AMC 10\">2001 AMC 10</a></b> (<b><a href=\"/wiki/index.php?title=2001_AMC_10_Problems\" title=\"2001 AMC 10 Problems\">Problems</a></b> • <b><a href=\"/wiki/index.php?title=2001_AMC_10_Answer_Key\" title=\"2001 AMC 10 Answer Key\">Answer Key</a></b> • <a rel=\"nofollow\" class=\"external text\" href=\"https://artofproblemsolving.com/community/c13\">Resources</a>)\n</td></tr>\n<tr>\n<td width=\"50%\" align=\"center\" rowspan=\"1\">Preceded&#160;by<br /><b><a href=\"/wiki/index.php?title=2001_AMC_10_Problems/Problem_15\" title=\"2001 AMC 10 Problems/Problem 15\">Problem 15</a></b>\n</td>\n<td width=\"50%\" align=\"center\" rowspan=\"1\">Followed&#160;by<br /><b><a href=\"/wiki/index.php?title=2001_AMC_10_Problems/Problem_17\" class=\"mw-redirect\" title=\"2001 AMC 10 Problems/Problem 17\">Problem 17</a></b>\n</td></tr>\n<tr>\n<td colspan=\"3\" style=\"text-align:center;\"><a href=\"/wiki/index.php?title=2001_AMC_10_Problems/Problem_1\" title=\"2001 AMC 10 Problems/Problem 1\">1</a> <b>•</b> <a href=\"/wiki/index.php?title=2001_AMC_10_Problems/Problem_2\" title=\"2001 AMC 10 Problems/Problem 2\">2</a> <b>•</b> <a href=\"/wiki/index.php?title=2001_AMC_10_Problems/Problem_3\" class=\"mw-redirect\" title=\"2001 AMC 10 Problems/Problem 3\">3</a> <b>•</b> <a href=\"/wiki/index.php?title=2001_AMC_10_Problems/Problem_4\" title=\"2001 AMC 10 Problems/Problem 4\">4</a> <b>•</b> <a href=\"/wiki/index.php?title=2001_AMC_10_Problems/Problem_5\" title=\"2001 AMC 10 Problems/Problem 5\">5</a> <b>•</b> <a href=\"/wiki/index.php?title=2001_AMC_10_Problems/Problem_6\" title=\"2001 AMC 10 Problems/Problem 6\">6</a> <b>•</b> <a href=\"/wiki/index.php?title=2001_AMC_10_Problems/Problem_7\" title=\"2001 AMC 10 Problems/Problem 7\">7</a> <b>•</b> <a href=\"/wiki/index.php?title=2001_AMC_10_Problems/Problem_8\" title=\"2001 AMC 10 Problems/Problem 8\">8</a> <b>•</b> <a href=\"/wiki/index.php?title=2001_AMC_10_Problems/Problem_9\" class=\"mw-redirect\" title=\"2001 AMC 10 Problems/Problem 9\">9</a> <b>•</b> <a href=\"/wiki/index.php?title=2001_AMC_10_Problems/Problem_10\" title=\"2001 AMC 10 Problems/Problem 10\">10</a> <b>•</b> <a href=\"/wiki/index.php?title=2001_AMC_10_Problems/Problem_11\" title=\"2001 AMC 10 Problems/Problem 11\">11</a> <b>•</b> <a href=\"/wiki/index.php?title=2001_AMC_10_Problems/Problem_12\" title=\"2001 AMC 10 Problems/Problem 12\">12</a> <b>•</b> <a href=\"/wiki/index.php?title=2001_AMC_10_Problems/Problem_13\" class=\"mw-redirect\" title=\"2001 AMC 10 Problems/Problem 13\">13</a> <b>•</b> <a href=\"/wiki/index.php?title=2001_AMC_10_Problems/Problem_14\" class=\"mw-redirect\" title=\"2001 AMC 10 Problems/Problem 14\">14</a> <b>•</b> <a href=\"/wiki/index.php?title=2001_AMC_10_Problems/Problem_15\" title=\"2001 AMC 10 Problems/Problem 15\">15</a> <b>•</b> <a href=\"/wiki/index.php?title=2001_AMC_10_Problems/Problem_16\" class=\"mw-redirect\" title=\"2001 AMC 10 Problems/Problem 16\">16</a> <b>•</b> <a href=\"/wiki/index.php?title=2001_AMC_10_Problems/Problem_17\" class=\"mw-redirect\" title=\"2001 AMC 10 Problems/Problem 17\">17</a> <b>•</b> <a href=\"/wiki/index.php?title=2001_AMC_1