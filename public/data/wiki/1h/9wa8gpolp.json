/b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_71\" title=\"2008 iTest Problems/Problem 71\">71</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_72\" title=\"2008 iTest Problems/Problem 72\">72</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_73\" title=\"2008 iTest Problems/Problem 73\">73</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_74\" title=\"2008 iTest Problems/Problem 74\">74</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_75\" title=\"2008 iTest Problems/Problem 75\">75</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_76\" title=\"2008 iTest Problems/Problem 76\">76</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_77\" title=\"2008 iTest Problems/Problem 77\">77</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_78\" title=\"2008 iTest Problems/Problem 78\">78</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_79\" title=\"2008 iTest Problems/Problem 79\">79</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_80\" title=\"2008 iTest Problems/Problem 80\">80</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_81\" title=\"2008 iTest Problems/Problem 81\">81</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_82\" title=\"2008 iTest Problems/Problem 82\">82</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_83\" title=\"2008 iTest Problems/Problem 83\">83</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_84\" title=\"2008 iTest Problems/Problem 84\">84</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_85\" title=\"2008 iTest Problems/Problem 85\">85</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_86\" title=\"2008 iTest Problems/Problem 86\">86</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_P