evel-1 tocsection-24\"><a href=\"#Problem_T9\"><span class=\"tocnumber\">24</span> <span class=\"toctext\">Problem T9</span></a></li>\n<li class=\"toclevel-1 tocsection-25\"><a href=\"#Problem_T10\"><span class=\"tocnumber\">25</span> <span class=\"toctext\">Problem T10</span></a></li>\n</ul>\n</div>\n\n<h2><span class=\"mw-headline\" id=\"Problem_I1\">Problem I1</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/index.php?title=2003_PMWC_Problems&amp;action=edit&amp;section=1\" title=\"Edit section: Problem I1\">edit</a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p><a href=\"/wiki/index.php?title=2003_PMWC_Problems/Problem_I1&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"2003 PMWC Problems/Problem I1 (page does not exist)\">Solution</a>\n</p>\n<h2><span class=\"mw-headline\" id=\"Problem_I2\">Problem I2</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/index.php?title=2003_PMWC_Problems&amp;action=edit&amp;section=2\" title=\"Edit section: Problem I2\">edit</a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p><img src=\"//latex.artofproblemsolving.com/c/0/a/c0ac8416a73660eec83d761e02407e922370520f.png\" class=\"latexcenter\" alt=\"[asy] size(7cm); pair M=(-1,0), N=(1,0),a=4/5*expi(pi/10),b=expi(37pi/100); draw((M--N)^^(origin--a)^^(origin--b)); draw(anglemark(N,origin,a,10)^^anglemark(a,origin,b)^^anglemark(b,origin,M,5)); label(&quot;$a$&quot;,origin,10*unit(unit(a)+unit(N))); label(&quot;$b$&quot;,origin,8*unit(unit(a)+unit(b))); label(&quot;$c$&quot;,origin,5*unit(unit(b)+unit(M))); label(&quot;$N$&quot;,N,E); label(&quot;$M$&quot;,M,W); //Credit to dasobson for the diagram[/asy]\" width=\"332\" height=\"138\" />\n<a href=\"/wiki/index.php?title=2003_PMWC_Problems/Problem_I2&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"2003 PMWC Problems/Problem I2 (page does not exist)\">Solution</a>\n</p>\n<h2><span class=\"mw-headline\" id=\"Problem_I3\">Problem I3</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/index.php?title=2003_PMWC_Problems&amp;action=edit&amp;section=3\" title=\"Edit section: Problem I3\">edit</a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p><img src=\"//latex.artofproblemsolving.com/f/8/9/f89f983a7aa4ad7f14620a3a8b4914e19d3148d5.png\" class=\"latexcenter\" alt=\"[asy] size(4cm); void blackbox(pair p) { pair a = (0,1/2.0); pair b = (1/2.0,0); filldraw((p-a-b)--(p+a-b)--(p+a+b)--(p-a+b)--cycle,black); } void whitebox(pair p) { pair a = (0,1/2.0); pair b = (1/2.0,0); fill((p-a-b)--(p+a-b)--(p+a+b)--(p-a+b)--cycle,white); draw((p-a-b)--(p+a-b)--(p+a+b)--(p-a+b)--cycle,black); } real len = 13/2; draw((-len,-len)--(len,len),linetype(&quot;3 3&quot;)); draw((len,-len)--(-len,len),linetype(&quot;3 3&quot;)); path b = (-len,-len)--(-len,len)--(len,len)--(len,-len)--cycle; draw(b^^(scale(9/13)*b),linetype(&quot;3 3&quot;)); for(int i = -2; i &lt;= 2; ++i) { for(int j = -2; j &lt;= 2; ++j) { if(abs(i)==abs(j)) { blackbox((j,i)); } else { whitebox((j,i)); } } } for(int i = -1; i &lt;= 1; i=i+2) { for(int j = -1; j &lt;= 1; j=j+2) { pair c=scale(5)*(i,j); blackbox(scale(4)*(i,j)); blackbox(c); blackbox(scale(6)*(i,j)); whitebox(c+(1,0)); whitebox(c+(0,1)); whitebox(c-(1,0)); whitebox(c-(0,1)); if(i==j) { whitebox(c-(1,0)+(0,1)); whitebox(c-(0,1)+(1,0)); } else { whitebox(c+(1,0)+(0,1)); whitebox(c-(1,0)-(0,1)); } } } //Credit to dasobson for the diagram[/asy]\" width=\"192\" height=\"192\" />\n<a href=\"/wiki/index.php?title=2003_PMWC_Problems/Problem_I3&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"2003 PMWC Problems/Problem I3 (page does not exist)\">Solution</a>\n</p>\n<h2><span class=\"mw-headline\" id=\"Problem_I4\">Problem I4</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/index.php?title=2003_PMWC_Problems&amp;action=edit&amp;section=4\" title=\"Edit section: Problem I4\">edit</a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p><a href=\"/wiki/index.php?title=2003_PMWC_Problems/Problem_I4&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"2003 PMWC Problems/Problem I4 (page does not exist)\">Solution</a>\n</p>\n<h2><span class=\"mw-headline\" id=\"Problem_I5\">Problem I5</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/index.php?title=2003_PMWC_Problems&amp;action=edit&amp;section=5\" title=\"Edit section: Problem I5\">edit</a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p><a href=\"/wiki/index.php?title=2003_PMWC_Problems/Problem_I5&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"2003 PMWC Problems/Problem I5 (page does not exist)\">Solution</a>\n</p>\n<h2><span class=\"mw-headline\" id=\"Problem_I6\">Problem I6</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/index.php?title=2003_PMWC_Problems&amp;action=edit&amp;section=6\" title=\"Edit section: Problem I6\">edit</a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p><img src=\"//latex.artofproblemsolving.com/d/b/5/db5fb20ed906d565b61e528587598bd24b437d2c.png\" class=\"latexcenter\" alt=\"[asy] size(5cm); pair C=origin, B=(0,1), A= (1,1),D=(4/3,0); pair E=intersectionpoint(A--C,B--D); draw(B--C--A--B--D--C); draw(A--D); label(&quot;$A$&quot;,A,NE); label(&quot;$B$&quot;,B,NW); label(&quot;$C$&quot;,C,SW); label(&quot;$D$&quot;,D,SE); label(&quot;$E$&quot;,E,S*2); //Credit to dasobson for the diagram[/asy]\" width=\"238\" height=\"185\" />\n<a href=\"/wiki/index.php?title=2003_PMWC_Problems/Problem_I6&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"2003 PMWC Problems/Problem I6 (page does not exist)\">Solution</a>\n</p>\n<h2><span class=\"mw-headline\" id=\"Problem_I7\">Problem I7</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/index.php?title=2003_PMWC_Problems&amp;action=edit&amp;section=7\" title=\"Edit section: Problem I7\">edit</a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p><a href=\"/wiki/index.php?title=2003_PMWC_Problems/Problem_I7&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"2003 PMWC Problems/Problem I7 (page does not exist)\">Solution</a>\n</p>\n<h2><span class=\"mw-headline\" id=\"Problem_I8\">Problem I8</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/index.php?title=2003_PMWC_Problems&amp;action=edit&amp;section=8\" title=\"Edit section: Problem I8\">edit</a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p><a href=\"/wiki/index.php?title=2003_PMWC_Problems/Problem_I8&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"2003 PMWC Problems/Problem I8 (page does not exist)\">Solution</a>\n</p>\n<h2><span class=\"mw-headline\" id=\"Problem_I9\">Problem I9</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/index.php?title=2003_PMWC_Problems&amp;action=edit&amp;section=9\" title=\"Edit section: Problem I9\">edit</a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p><a href=\"/wiki/index.php?title=2003_PMWC_Problems/Problem_I9&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"2003 PMWC Problems/Problem I9 (page does not exist)\">Solution</a>\n</p>\n<h2><span class=\"mw-headline\" id=\"Problem_I10\">Problem I10</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/index.php?title=2003_PMWC_Problems&amp;action=edit&amp;section=10\" title=\"Edit section: Problem I10\">edit</a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p><img src=\"//latex.artofproblemsolving.com/e/2/5/e2598de727f259409c74399d517062ed6ec27654.png\" class=\"latexcenter\" alt=\"[asy] size(8cm); pair A=(2,0),B=(2,1),C=(0,1),D=origin,E=(1,1),F=(B+A)/2,H=(1.0/2,0); draw(A--B--C--D--cycle); filldraw(D--E--B--F--H--cycle,gray(.8)); label(&quot;$A$&quot;,A,SE);label(&quot;$B$&quot;,B,NE);label(&quot;$C$&quot;,C,NW);label(&quot;$D$&quot;,D,SW);label(&quot;$E$&quot;,E,N);label(&quot;$F$&quot;,F,E);label(&quot;$H$&quot;,H,S); //Credit to dasobson for the diagram[/asy]\" width=\"378\" height=\"212\" />\n<a href=\"/wiki/index.php?title=2003_PMWC_Problems/Problem_I10&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"2003 PMWC Problems/Problem I10 (page does not exist)\">Solution</a>\n</p>\n<h2><span class=\"mw-headline\" id=\"Problem_I11\">Problem I11</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/index.php?title=2003_PMWC_Problems&amp;action=edit&amp;section=11\" title=\"Edit section: Problem I11\">edit</a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p><a href=\"/wiki/index.php?title=2003_PMWC_Problems/Problem_I11&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"2003 PMWC Problems/Problem I11 (page does not exist)\">Solution</a>\n</p>\n<h2><span class=\"mw-headline\" id=\"Problem_I12\">Problem I12</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/index.php?title=2003_PMWC_Problems&amp;action=edit&amp;section=12\" title=\"Edit section: Problem I12\">edit</a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p><a href=\"/wiki/index.php?title=2003_PMWC_Problems/Problem_I12&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"2003 PMWC Problems/Problem I12 (page does not exist)\">Solution</a>\n</p>\n<h2><span class=\"mw-headline\" id=\"Problem_I13\">Problem I13</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/index.php?title=2003_PMWC_Problems&amp;action=edit&amp;section=13\" title=\"Edit section: Problem I13\">edit</a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p><a href=\"/wiki/index.php?title=2003_PMWC_Problems/Problem_I13&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"2003 PMWC Problems/Problem I13 (page does not exist)\">Solution</a>\n</p>\n<h2><span class=\"mw-headline\" id=\"Problem_I14\">Problem I14</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/index.php?title=2003_PMWC_Problems&amp;action=edit&amp;section=14\" title=\"Edit section: Problem I14\">edit</a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p><img src=\"//latex.artofproblemsolving.com/5/7/3/5737ed1f6ec329fdcf2407a1395e54ab308221fa.png\" class=\"latexcenter\" alt=\"[asy] size(14cm); path[] a = arc((0,0),1,0,180)^^((-1,0)--(1,0)); draw(a); draw(shift((5,0))*scale(2)*a); draw(shift((12,0))*scale(3)*a); label(&quot;I&quot;,origin,S*2.5); label(&quot;II&quot;,(5,0),S*2.5); label(&quot;III&quot;,(12,0),S*2.5); //Credit to dasobson for the diagram[/asy]\" width=\"662\" height=\"158\" />\n<a href=\"/wiki/index.php?title=2003_PMWC_Problems/Problem_I14&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"2003 PMWC Problems/Problem I14 (page does not exist)\">Solution</a>\n</p>\n<h2><span class=\"mw-headline\" id=\"Problem_I15\">Problem I15</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/index.php?title=2003_PMWC_Problems&amp;action=edit&amp;section=15\" title=\"Edit section: Problem I15\">edit</a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p><a href=\"/wiki/index.php?title=2003_PMWC_Problems/Problem_I15&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"2003 PMWC Problems/Problem I15 (page does not exist)\">Solution</a>\n</p>\n<h2><span class=\"mw-headline\" id=\"Problem_T1\">Problem T1</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/index.php?title=2003_PMWC_Problems&amp;action=edit&amp;section=16\" title=\"Edit section: Problem T1\">edit</a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p><a href=\"/wiki/index.php?title=2003_PMWC_Problems/Problem_T1&amp;action=edit&amp;redl