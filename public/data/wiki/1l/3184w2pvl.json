> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_32\" title=\"2008 iTest Problems/Problem 32\">32</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_33\" title=\"2008 iTest Problems/Problem 33\">33</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_34\" title=\"2008 iTest Problems/Problem 34\">34</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_35\" title=\"2008 iTest Problems/Problem 35\">35</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_36\" title=\"2008 iTest Problems/Problem 36\">36</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_37\" title=\"2008 iTest Problems/Problem 37\">37</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_38\" title=\"2008 iTest Problems/Problem 38\">38</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_39\" title=\"2008 iTest Problems/Problem 39\">39</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_40\" title=\"2008 iTest Problems/Problem 40\">40</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_41\" title=\"2008 iTest Problems/Problem 41\">41</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_42\" title=\"2008 iTest Problems/Problem 42\">42</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_43\" title=\"2008 iTest Problems/Problem 43\">43</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_44\" title=\"2008 iTest Problems/Problem 44\">44</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_45\" title=\"2008 iTest Problems/Problem 45\">45</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_46\" title=\"2008 iTest Problems/Problem 46\">46</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_47\" title=\"2008 iTest Problems/Problem 47\">47</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_