<a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_76\" title=\"2008 iTest Problems/Problem 76\">76</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_77\" title=\"2008 iTest Problems/Problem 77\">77</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_78\" title=\"2008 iTest Problems/Problem 78\">78</a> <b>•</b> <a class=\"mw-selflink selflink\">79</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_80\" title=\"2008 iTest Problems/Problem 80\">80</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_81\" title=\"2008 iTest Problems/Problem 81\">81</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_82\" title=\"2008 iTest Problems/Problem 82\">82</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_83\" title=\"2008 iTest Problems/Problem 83\">83</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_84\" title=\"2008 iTest Problems/Problem 84\">84</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_85\" title=\"2008 iTest Problems/Problem 85\">85</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_86\" title=\"2008 iTest Problems/Problem 86\">86</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_87\" title=\"2008 iTest Problems/Problem 87\">87</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_88\" title=\"2008 iTest Problems/Problem 88\">88</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_89\" title=\"2008 iTest Problems/Problem 89\">89</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_90\" title=\"2008 iTest Problems/Problem 90\">90</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_91\" title=\"2008 iTest Problems/Problem 91\">91</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_92\" title=\"2008 iTest Problems/Problem 92\">92</a> <b>•</b