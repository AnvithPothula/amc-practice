t_Problems/Problem_91\" title=\"2008 iTest Problems/Problem 91\">91</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_92\" title=\"2008 iTest Problems/Problem 92\">92</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_93\" title=\"2008 iTest Problems/Problem 93\">93</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_94\" title=\"2008 iTest Problems/Problem 94\">94</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_95\" title=\"2008 iTest Problems/Problem 95\">95</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_96\" title=\"2008 iTest Problems/Problem 96\">96</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_97\" title=\"2008 iTest Problems/Problem 97\">97</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_98\" title=\"2008 iTest Problems/Problem 98\">98</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_99\" title=\"2008 iTest Problems/Problem 99\">99</a> <b>•</b> <a href=\"/wiki/index.php?title=2008_iTest_Problems/Problem_100\" title=\"2008 iTest Problems/Problem 100\">100</a>\n</td></tr></tbody></table>\n<!-- \nNewPP limit report\nCached time: 20261017220258\nCache expiry: 86400\nReduced expiry: false\nComplications: []\nCPU time usage: 0.045 seconds\nReal time usage: 0.057 seconds\nPreprocessor visited node count: 85/1000000\nPost‐expand include size: 5242/2097152 bytes\nTemplate argument size: 8/2097152 bytes\nHighest expansion depth: 3/100\nExpensive parser function count: 0/100\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 3358/5000000 bytes\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%    6.530      1 Template:2008_iTest_box\n100.00%    6.530      1 -total\n-->\n\n<!-- Saved in parser cache with key wiki-wiki_:pcache:17164:|#|:idhash:canonical and timestamp 20261017220258 and revision id 101041. Rendering was triggered because: api-parse\n