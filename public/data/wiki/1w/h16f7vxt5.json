<a href=\"/wiki/index.php?title=1961_AHSME_Problems/Problem_28\" title=\"1961 AHSME Problems/Problem 28\">28</a> <b>•</b> <a href=\"/wiki/index.php?title=1961_AHSME_Problems/Problem_29\" title=\"1961 AHSME Problems/Problem 29\">29</a> <b>•</b> <a href=\"/wiki/index.php?title=1961_AHSME_Problems/Problem_30\" title=\"1961 AHSME Problems/Problem 30\">30</a> <b>•</b> <a href=\"/wiki/index.php?title=1961_AHSME_Problems/Problem_31\" title=\"1961 AHSME Problems/Problem 31\">31</a> <b>•</b> <a href=\"/wiki/index.php?title=1961_AHSME_Problems/Problem_32\" title=\"1961 AHSME Problems/Problem 32\">32</a> <b>•</b> <a href=\"/wiki/index.php?title=1961_AHSME_Problems/Problem_33\" title=\"1961 AHSME Problems/Problem 33\">33</a> <b>•</b> <a href=\"/wiki/index.php?title=1961_AHSME_Problems/Problem_34\" title=\"1961 AHSME Problems/Problem 34\">34</a> <b>•</b> <a href=\"/wiki/index.php?title=1961_AHSME_Problems/Problem_35\" title=\"1961 AHSME Problems/Problem 35\">35</a> <b>•</b> <a href=\"/wiki/index.php?title=1961_AHSME_Problems/Problem_36\" title=\"1961 AHSME Problems/Problem 36\">36</a> <b>•</b> <a href=\"/wiki/index.php?title=1961_AHSME_Problems/Problem_37\" title=\"1961 AHSME Problems/Problem 37\">37</a> <b>•</b> <a href=\"/wiki/index.php?title=1961_AHSME_Problems/Problem_38\" title=\"1961 AHSME Problems/Problem 38\">38</a> <b>•</b> <a href=\"/wiki/index.php?title=1961_AHSME_Problems/Problem_39\" title=\"1961 AHSME Problems/Problem 39\">39</a> <b>•</b> <a href=\"/wiki/index.php?title=1961_AHSME_Problems/Problem_40\" title=\"1961 AHSME Problems/Problem 40\">40</a>\n</td></tr>\n<tr>\n<td align=\"center\" colspan=\"3\"><b><a href=\"/wiki/index.php?title=AHSME_Problems_and_Solutions\" title=\"AHSME Problems and Solutions\"> All AHSME Problems and Solutions</a></b>\n</td></tr></tbody></table>\n<p><br />\n</p>\n<div class=\"print\">\n<div style=\"display:flex;width:100%;justify-content:space-between;align-items:center\">\n<div>\n<p><span class=\"mw-default-size\" typeof=\"mw:File\"><a