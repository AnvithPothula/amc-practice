 <b>•</b> <a href=\"/wiki/index.php?title=1998_AJHSME_Problems/Problem_21\" title=\"1998 AJHSME Problems/Problem 21\">21</a> <b>•</b> <a class=\"mw-selflink selflink\">22</a> <b>•</b> <a href=\"/wiki/index.php?title=1998_AJHSME_Problems/Problem_23\" title=\"1998 AJHSME Problems/Problem 23\">23</a> <b>•</b> <a href=\"/wiki/index.php?title=1998_AJHSME_Problems/Problem_24\" title=\"1998 AJHSME Problems/Problem 24\">24</a> <b>•</b> <a href=\"/wiki/index.php?title=1998_AJHSME_Problems/Problem_25\" title=\"1998 AJHSME Problems/Problem 25\">25</a>\n</td></tr>\n<tr>\n<td colspan=\"3\" style=\"text-align:center;\"><b><a href=\"/wiki/index.php?title=AMC_8_Problems_and_Solutions\" title=\"AMC 8 Problems and Solutions\"> All AJHSME/AMC 8 Problems and Solutions</a></b>\n</td></tr></tbody></table>\n<ul><li><a href=\"/wiki/index.php?title=AJHSME\" class=\"mw-redirect\" title=\"AJHSME\">AJHSME</a></li>\n<li><a href=\"/wiki/index.php?title=AJHSME_Problems_and_Solutions\" class=\"mw-redirect\" title=\"AJHSME Problems and Solutions\">AJHSME Problems and Solutions</a></li>\n<li><a href=\"/wiki/index.php?title=Mathematics_competition_resources\" class=\"mw-redirect\" title=\"Mathematics competition resources\">Mathematics competition resources</a></li></ul>\n<div class=\"print\">\n<div style=\"display:flex;width:100%;justify-content:space-between;align-items:center\">\n<div>\n<p><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"/wiki/index.php?title=File:AMC_Logo.png\" class=\"mw-file-description\"><img src=\"https://artofproblemsolving.com/wiki/images/d/d1/AMC_Logo.png\" decoding=\"async\" width=\"97\" height=\"84\" class=\"mw-file-element\" /></a></span>\n</p>\n</div>\n<div style=\"flex-grow:1;text-align:right\">\n<p>These problems are copyrighted &#169; by the <a rel=\"nofollow\" class=\"external text\" href=\"https://www.maa.org\">Mathematical Association of America</a>. \n</p>\n</div>\n<div style=\"clear:both;\"></div>\n</div></div>\n<!-- \nNewPP limit report\nCached tim