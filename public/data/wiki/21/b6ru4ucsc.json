{"title":"List of universities in Japan","text":"<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><table cellpadding=\"5\">\n<tbody><tr>\n<td valign=\"top\" align=\"left\">The University of Tokyo</td>\n<td valign=\"top\" align=\"left\">(東京大学)</td>\n</tr>\n<tr>\n<td valign=\"top\" align=\"left\">Kyoto University</td>\n<td valign=\"top\" align=\"left\">(京都大学)</td>\n</tr>\n<tr>\n<td valign=\"top\" align=\"left\">Nagoya University</td>\n<td valign=\"top\" align=\"left\">(名古屋大学)</td>\n</tr>\n<tr>\n<td valign=\"top\" align=\"left\">Osaka University</td>\n<td valign=\"top\" align=\"left\">(大阪大学)</td>\n</tr>\n<tr>\n<td valign=\"top\" align=\"left\">Tohoku University</td>\n<td valign=\"top\" align=\"left\">(東北大学)</td>\n</tr>\n<tr>\n<td valign=\"top\" align=\"left\">Hokkaido University</td>\n<td valign=\"top\" align=\"left\">(北海道大学)</td>\n</tr>\n<tr>\n<td valign=\"top\" align=\"left\">Tokyo Institute of Technology</td>\n<td valign=\"top\" align=\"left\">(東京工業大学)</td>\n</tr>\n<tr>\n<td valign=\"top\" align=\"left\">Kyushu University</td>\n<td valign=\"top\" align=\"left\">(九州大学)</td>\n</tr>\n<tr>\n<td valign=\"top\" align=\"left\">University of Tsukuba</td>\n<td valign=\"top\" align=\"left\">(筑波大学)</td>\n</tr>\n<tr>\n<td valign=\"top\" align=\"left\">Chiba University</td>\n<td valign=\"top\" align=\"left\">(千葉大学)</td>\n</tr>\n<tr>\n<td valign=\"top\" align=\"left\">Keio University</td>\n<td valign=\"top\" align=\"left\">(慶應義塾大学)</td>\n</tr>\n<tr>\n<td valign=\"top\" align=\"left\">Okayama University</td>\n<td valign=\"top\" align=\"left\">(岡山大学)</td>\n</tr>\n<tr>\n<td valign=\"top\" align=\"left\">Kobe University</td>\n<td valign=\"top\" align=\"left\">(神戸大学)</td>\n</tr>\n<tr>\n<td valign=\"top\" align=\"left\">The University of Tokushima</td>\n<td valign=\"top\" align=\"left\">(徳島大学)</td>\n</tr>\n<tr>\n<td valign=\"top\" align=\"left\">Tokyo University of Science</td>\n<td valign=\"top\" align=\"left\">(東京理科大学)</td>\n</tr>\n<tr>\n<td valign=\"top\" align