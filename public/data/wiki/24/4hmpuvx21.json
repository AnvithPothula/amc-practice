>\n</th>\n<td>suli\n</td>\n<td>2015\n</td>\n<td><a rel=\"nofollow\" class=\"external text\" href=\"//www.artofproblemsolving.com/community/c3h626046\">Initial Discussion</a>\n</td>\n<td><a rel=\"nofollow\" class=\"external text\" href=\"//www.artofproblemsolving.com/community/c3h626046\">Problems</a>\n</td>\n<td><a rel=\"nofollow\" class=\"external text\" href=\"//www.artofproblemsolving.com/community/c3h626046\">Answers</a>\n</td>\n<td><a rel=\"nofollow\" class=\"external text\" href=\"//www.artofproblemsolving.com/community/c3h626046\">Results/Discussion</a>\n</td></tr></tbody></table>\n<h3><span class=\"mw-headline\" id=\"Chapter\">Chapter</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/index.php?title=Mock_MATHCOUNTS&amp;action=edit&amp;section=5\" title=\"Edit section: Chapter\">edit</a><span class=\"mw-editsection-bracket\">]</span></span></h3>\n<table class=\"wikitable\" style=\"text-align:center;width:100%\">\n\n<tbody><tr>\n<td>\n</td>\n<th scope=\"col\"><b>Author</b>\n</th>\n<th scope=\"col\"><b>Year</b>\n</th>\n<th scope=\"col\"><b>Initial Discussion</b>\n</th>\n<th scope=\"col\"><b>Problems</b>\n</th>\n<th scope=\"col\" width=\"80\"><b>Answers</b>\n</th>\n<th scope=\"col\"><b>Results/Discussion</b>\n</th></tr>\n<tr>\n<th scope=\"row\"><b>Mock MATHCOUNTS A</b>\n</th>\n<td>#H34N1\n</td>\n<td>2006\n</td>\n<td><a rel=\"nofollow\" class=\"external text\" href=\"//artofproblemsolving.com/community/c112370\">Initial Discussion</a>\n</td>\n<td><a rel=\"nofollow\" class=\"external text\" href=\"//artofproblemsolving.com/community/c112370\">Problems</a>\n</td>\n<td><a rel=\"nofollow\" class=\"external text\" href=\"//artofproblemsolving.com/community/c112370\">Answers</a>\n</td>\n<td>N/A\n</td></tr>\n<tr>\n<th scope=\"row\"><b>Mock MC Chapter</b>\n</th>\n<td>PowerOfPi\n</td>\n<td>2009\n</td>\n<td><a rel=\"nofollow\" class=\"external text\" href=\"//artofproblemsolving.com/community/c594864h310266\">Initial Discus