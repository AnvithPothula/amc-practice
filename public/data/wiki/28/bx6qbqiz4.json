ef=\"/wiki/index.php?title=1971_AHSME_Problems/Problem_28\" title=\"1971 AHSME Problems/Problem 28\">28</a> <b>•</b> <a class=\"mw-selflink selflink\">29</a> <b>•</b> <a href=\"/wiki/index.php?title=1971_AHSME_Problems/Problem_30\" title=\"1971 AHSME Problems/Problem 30\">30</a> <b>•</b> <a href=\"/wiki/index.php?title=1971_AHSME_Problems/Problem_31\" title=\"1971 AHSME Problems/Problem 31\">31</a> <b>•</b> <a href=\"/wiki/index.php?title=1971_AHSME_Problems/Problem_32\" title=\"1971 AHSME Problems/Problem 32\">32</a> <b>•</b> <a href=\"/wiki/index.php?title=1971_AHSME_Problems/Problem_33\" title=\"1971 AHSME Problems/Problem 33\">33</a> <b>•</b> <a href=\"/wiki/index.php?title=1971_AHSME_Problems/Problem_34\" title=\"1971 AHSME Problems/Problem 34\">34</a> <b>•</b> <a href=\"/wiki/index.php?title=1971_AHSME_Problems/Problem_35\" title=\"1971 AHSME Problems/Problem 35\">35</a>\n</td></tr>\n<tr>\n<td align=\"center\" colspan=\"3\"><b><a href=\"/wiki/index.php?title=AHSME_Problems_and_Solutions\" title=\"AHSME Problems and Solutions\"> All AHSME Problems and Solutions</a></b>\n</td></tr></tbody></table>\n<div class=\"print\">\n<div style=\"display:flex;width:100%;justify-content:space-between;align-items:center\">\n<div>\n<p><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"/wiki/index.php?title=File:AMC_Logo.png\" class=\"mw-file-description\"><img src=\"https://artofproblemsolving.com/wiki/images/d/d1/AMC_Logo.png\" decoding=\"async\" width=\"97\" height=\"84\" class=\"mw-file-element\" /></a></span>\n</p>\n</div>\n<div style=\"flex-grow:1;text-align:right\">\n<p>These problems are copyrighted &#169; by the <a rel=\"nofollow\" class=\"external text\" href=\"https://www.maa.org\">Mathematical Association of America</a>. \n</p>\n</div>\n<div style=\"clear:both;\"></div>\n</div></div>\n<!-- \nNewPP limit report\nCached time: 20261017170628\nCache expiry: 86400\nReduced expiry: false\nComplications: []\nCPU time usage: 0.037 seconds\nReal time usage: 0.057 se