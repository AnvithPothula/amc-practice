ref=\"/wiki/index.php?title=2021_Fall_AMC_10A_Problems/Problem_15\" title=\"2021 Fall AMC 10A Problems/Problem 15\">15</a> <b>•</b> <a href=\"/wiki/index.php?title=2021_Fall_AMC_10A_Problems/Problem_16\" title=\"2021 Fall AMC 10A Problems/Problem 16\">16</a> <b>•</b> <a href=\"/wiki/index.php?title=2021_Fall_AMC_10A_Problems/Problem_17\" title=\"2021 Fall AMC 10A Problems/Problem 17\">17</a> <b>•</b> <a href=\"/wiki/index.php?title=2021_Fall_AMC_10A_Problems/Problem_18\" title=\"2021 Fall AMC 10A Problems/Problem 18\">18</a> <b>•</b> <a href=\"/wiki/index.php?title=2021_Fall_AMC_10A_Problems/Problem_19\" title=\"2021 Fall AMC 10A Problems/Problem 19\">19</a> <b>•</b> <a href=\"/wiki/index.php?title=2021_Fall_AMC_10A_Problems/Problem_20\" class=\"mw-redirect\" title=\"2021 Fall AMC 10A Problems/Problem 20\">20</a> <b>•</b> <a href=\"/wiki/index.php?title=2021_Fall_AMC_10A_Problems/Problem_21\" class=\"mw-redirect\" title=\"2021 Fall AMC 10A Problems/Problem 21\">21</a> <b>•</b> <a href=\"/wiki/index.php?title=2021_Fall_AMC_10A_Problems/Problem_22\" title=\"2021 Fall AMC 10A Problems/Problem 22\">22</a> <b>•</b> <a href=\"/wiki/index.php?title=2021_Fall_AMC_10A_Problems/Problem_23\" class=\"mw-redirect\" title=\"2021 Fall AMC 10A Problems/Problem 23\">23</a> <b>•</b> <a href=\"/wiki/index.php?title=2021_Fall_AMC_10A_Problems/Problem_24\" title=\"2021 Fall AMC 10A Problems/Problem 24\">24</a> <b>•</b> <a href=\"/wiki/index.php?title=2021_Fall_AMC_10A_Problems/Problem_25\" class=\"mw-redirect\" title=\"2021 Fall AMC 10A Problems/Problem 25\">25</a>\n</td></tr>\n<tr>\n<td colspan=\"3\" style=\"text-align:center;\"><b><a href=\"/wiki/index.php?title=AMC_10_Problems_and_Solutions\" title=\"AMC 10 Problems and Solutions\"> All AMC 10 Problems and Solutions</a></b>\n</td></tr></tbody></table>\n<div class=\"print\">\n<div style=\"display:flex;width:100%;justify-content:space-between;align-items:center\">\n<div>\n<p><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"