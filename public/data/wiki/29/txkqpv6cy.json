{"title":"1997 PMWC Problems/Problem I4","text":"<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><h2><span class=\"mw-headline\" id=\"Problem\">Problem</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/index.php?title=1997_PMWC_Problems/Problem_I4&amp;action=edit&amp;section=1\" title=\"Edit section: Problem\">edit</a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p>Each of the three diagrams in the image show a balance of weights using different objects. How many squares will balance a circle?\n</p><p><img src=\"//latex.artofproblemsolving.com/2/a/d/2ad31251c9663abdb71a2c9afbcefc8ab30416c7.png\" class=\"latexcenter\" alt=\"[asy] /* File unicodetex not found. */ /* Geogebra to Asymptote conversion, documentation at artofproblemsolving.com/Wiki, go to User:Azjps/geogebra */ import graph; size(5.12cm);  real labelscalefactor = 0.5; /* changes label-to-point distance */ pen dps = linewidth(0.7) + fontsize(10); defaultpen(dps); /* default pen style */  pen dotstyle = black; /* point style */  real xmin = -0.43, xmax = 4.69, ymin = -0.49, ymax = 2.22; /* image dimensions */ draw((0.23,0.23)--(0.59,0.23)--(0.41,0.54)--cycle);  draw((1.27,1.04)--(1.63,1.04)--(1.45,1.35)--cycle);  draw((1.45,0.23)--(1.52,0.3)--(1.59,0.3)--(1.56,0.38)--(1.59,0.46)--(1.52,0.46)--(1.45,0.54)--(1.38,0.46)--(1.31,0.46)--(1.35,0.38)--(1.31,0.3)--(1.38,0.3)--cycle);  draw((1.8,1.04)--(1.87,1.11)--(1.94,1.11)--(1.91,1.19)--(1.94,1.27)--(1.87,1.27)--(1.8,1.35)--(1.73,1.27)--(1.66,1.27)--(1.7,1.19)--(1.66,1.11)--(1.73,1.11)--cycle);  draw((1.27,1.85)--(1.63,1.85)--(1.45,2.16)--cycle);  draw((1.73,0.23)--(1.88,0.23)--(1.88,0.37)--(1.73,0.37)--cycle);  draw((0.52,1.04)--(0.66,1.04)--(0.66,1.18)--(0.52,1.18)--cycle);  draw((1.64,1.85)--(1.79,1.85)--(1.79,1.99)--(1.64,1.99)--cycle);  draw((1.82,1.85)--(1.96,1.85)--(1.96,1.99)--(1.82,1.99)--cycle);  /* draw figures */ draw((0,0)--(2.18,0));  draw((0.41,0)--(0.41,0.23));  draw((1.63,0)--(1.63,0.23));  draw((0.95,-0.15)--(1.09,0));  draw((1.23,-0.15)--(1.09,0));  draw((1.23,-0.15)--(0.95,-0.15));  draw((0.23,0.23)--(0.59,0.23));  draw((0.59,0.23)--(0.41,0.54));  draw((0.41,0.54)--(0.23,0.23));  draw((0.08,0.23)--(0.73,0.23));  draw((1.28,0.23)--(1.98,0.23));  draw((1.31,0.46)--(1.35,0.38));  draw((1.59,0.3)--(1.56,0.38));  draw((1.59,0.46)--(1.56,0.38));  draw((1.31,0.3)--(1.35,0.38));  draw((1.31,0.46)--(1.38,0.46));  draw((1.38,0.46)--(1.45,0.54));  draw((1.52,0.3)--(1.45,0.23));  draw((1.59,0.3)--(1.52,0.3));  draw((1.52,0.46)--(1.45,0.54));  draw((1.59,0.46)--(1.52,0.46));  draw((1.31,0.3)--(1.38,0.3));  draw((1.38,0.3)--(1.45,0.23));  draw((0,0.81)--(2.18,0.81));  draw((0.41,0.81)--(0.41,1.04));  draw((1.63,0.81)--(1.63,1.04));  draw((0.95,0.66)--(1.09,0.81));  draw((1.23,0.66)--(1.09,0.81));  draw((1.23,0.66)--(0.95,0.66));  draw((0.08,1.04)--(0.73,1.04));  draw((1.28,1.04)--(1.98,1.04));  draw((1.72,1.04)--(1.89,1.04));  draw(circle((0.25,1.21), 0.17));  draw((1.45,0.23)--(1.52,0.3));  draw((1.52,0.3)--(1.59,0.3));  draw((1.52,0.46)--(1.45,0.54));  draw((1.38,0.46)--(1.31,0.46));  draw((1.31,0.3)--(1.38,0.3));  draw((1.38,0.3)--(1.45,0.23));  draw((1.8,1.04)--(1.87,1.11));  draw((1.87,1.11)--(1.94,1.11));  draw((1.94,1.11)--(1.91,1.19));  draw((1.91,1.19)--(1.94,1.27));  draw((1.94,1.27)--(1.87,1.27));  draw((1.87,1.27)--(1.8,1.35));  draw((1.8,1.35)--(1.73,1.27));  draw((1.73,1.27)--(1.66,1.27));  draw((1.66,1.27)--(1.7,1.19));  draw((1.7,1.19)--(1.66,1.11));  draw((1.66,1.11)--(1.73,1.11));  draw((1.73,1.11)--(1.8,1.04));  draw((0,1.62)--(2.18,1.62));  draw((0.41,1.62)--(0.41,1.85));  draw((1.63,1.62)--(1.63,1.85));  draw((0.95,1.47)--(1.09,1.62));  draw((1.23,1.47)--(1.09,1.62));  draw((1.23,1.47)--(0.95,1.47));  draw((0.23,1.85)--(0.59,1.85));  draw((0.08,1.85)--(0.73,1.85));  draw((1.28,1.85)--(1.98,1.85));  draw(circle((0.41,2.02), 0.17));  draw((1.73,0.23)--(1.88,0.23));  draw((1.88,0.23)--(1.88,0.37));  draw((1.88,0.37)--(1.73,0.37));  draw((1.73,0.37)--(1.73,0.23));  /* dots and labels */ clip((xmin,ymin)--(xmin,ymax)--(xmax,ymax)--(xmax,ymin)--cycle);  /* end of picture */ //Credit to dasobson for the diagram[/asy]\" width=\"228\" height=\"245\" />\n</p>\n<h2><span class=\"mw-headline\" id=\"Solution\">Solution</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/index.php?title=1997_PMWC_Problems/Problem_I4&amp;action=edit&amp;section=2\" title=\"Edit section: Solution\">edit</a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p><img src=\"//latex.artofproblemsolving.com/e/e/1/ee147c118ae20c5aa91fab34f9072ebdc4fe4f0d.png\" class=\"latex\" alt=\"$\\circ=\\triangle+2$\" style=\"vertical-align: -1px\" width=\"80\" height=\"15\" /> <img src=\"//latex.artofproblemsolving.com/b/6/c/b6cf65b1f2fbdf388e3daeff9b96b34d3399d777.png\" class=\"latex\" alt=\"$\\square$\" style=\"vertical-align: -1px\" width=\"16\" height=\"14\" />\n</p><p><img src=\"//latex.artofproblemsolving.com/a/9/7/a97be735f96b9c668905616f95fc286b5c13b0ab.png\" class=\"latex\" alt=\"$\\circ+\\square=\\triangle+\\star$\" style=\"vertical-align: -4px\" width=\"119\" height=\"18\" />\n</p><p><img src=\"//latex.artofproblemsolving.com/5/3/9/5396143ec0b8d91b8600449aac24833e4629c88d.png\" class=\"latex\" alt=\"$\\triangle+2$\" style=\"vertical-align: -1px\" width=\"47\" height=\"15\" /> <img src=\"//latex.artofproblemsolving.com/6/f/e/6fef53511253ab06d54c51cf49a3965e9b840c2f.png\" class=\"latex\" alt=\"$\\square+\\square=\\triangle+\\star$\" style=\"vertical-align: -1px\" width=\"122\" height=\"15\" />\n</p><p><img src=\"//latex.artofproblemsolving.com/7/c/d/7cde695f2e4542fd01f860a89189f47a27143b66.png\" class=\"latex\" alt=\"$3$\" style=\"vertical-align: -1px\" width=\"11\" height=\"14\" /> <img src=\"//latex.artofproblemsolving.com/5/8/4/584bd7fce04241b104159c245cc4429995376f3e.png\" class=\"latex\" alt=\"$\\square=\\star$\" width=\"47\" height=\"12\" />\n</p><p>