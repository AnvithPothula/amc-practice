msolving.com/8/2/2/8226667b93419d9dba3f69f8c9031040b03b080f.png\" class=\"latex\" alt=\"$939$\" style=\"vertical-align: -1px\" width=\"29\" height=\"14\" />, <img src=\"//latex.artofproblemsolving.com/e/2/a/e2a087d2a8acf12358ba780168dfbcad381d138f.png\" class=\"latex\" alt=\"$951$\" style=\"vertical-align: 0px\" width=\"26\" height=\"13\" />, <img src=\"//latex.artofproblemsolving.com/8/9/1/8917333909ca9d9b430aee7b03255d213705999e.png\" class=\"latex\" alt=\"$953$\" style=\"vertical-align: -1px\" width=\"29\" height=\"14\" />, <img src=\"//latex.artofproblemsolving.com/3/0/2/302085007fb79c2df6b58c186dc8519114d6f137.png\" class=\"latex\" alt=\"$955$\" style=\"vertical-align: -1px\" width=\"29\" height=\"14\" />, <img src=\"//latex.artofproblemsolving.com/2/3/1/231f930cba4561a28f8a83c7609a0122be9b82d7.png\" class=\"latex\" alt=\"$957$\" style=\"vertical-align: -1px\" width=\"29\" height=\"14\" />, <img src=\"//latex.artofproblemsolving.com/b/5/2/b523ce53a872e3bb356762ce605242e4dd7c41e0.png\" class=\"latex\" alt=\"$959$\" style=\"vertical-align: -1px\" width=\"29\" height=\"14\" />, <img src=\"//latex.artofproblemsolving.com/f/3/b/f3b7a23e6cf225efc643d342eaeac6807d54981f.png\" class=\"latex\" alt=\"$971$\" style=\"vertical-align: -1px\" width=\"29\" height=\"14\" />, <img src=\"//latex.artofproblemsolving.com/f/6/b/f6b3843a72e20236ad81f1dee30fac8e5ca70c5e.png\" class=\"latex\" alt=\"$973$\" width=\"26\" height=\"12\" />, <img src=\"//latex.artofproblemsolving.com/e/f/f/efff00574137efc9e9d43218dadf631aaa4bfeff.png\" class=\"latex\" alt=\"$975$\" width=\"26\" height=\"12\" />, <img src=\"//latex.artofproblemsolving.com/8/5/8/858943f22272434720e77ef88cfb842c772d2013.png\" class=\"latex\" alt=\"$977$\" width=\"27\" height=\"12\" />, <img src=\"//latex.artofproblemsolving.com/d/e/5/de58f4479abeeebc8fb50bd04af83e2c1bf631ae.png\" class=\"latex\" alt=\"$979$\" width=\"26\" height=\"12\" />, <img src=\"//latex.artofproblemsolving.com/d/9/d/d9d46846c39e13a30902b5971397494dddd55730.png\" class=\"latex\" alt=\"$991$\" style=\"vertical-align: 0px\" width=\"26\" height=\"13\" />, <img src=\"//latex.artofproblemsolving.com/5/3/5/535e746a6697977eb9826efba4c60436d4d2db2b.png\" class=\"latex\" alt=\"$993$\" style=\"vertical-align: -1px\" width=\"29\" height=\"14\" />, <img src=\"//latex.artofproblemsolving.com/e/9/f/e9f403449385d379f95d7301878fdf50310e3835.png\" class=\"latex\" alt=\"$995$\" width=\"26\" height=\"12\" />, <img src=\"//latex.artofproblemsolving.com/9/0/7/90782e3f18f6a430876413c43e3d163e0e8ae3f8.png\" class=\"latex\" alt=\"$997$\" width=\"27\" height=\"12\" />, and <img src=\"//latex.artofproblemsolving.com/0/7/0/0705411d92671faf1fe5602cfef8f353c7f0f83d.png\" class=\"latex\" alt=\"$999$\" style=\"vertical-align: -1px\" width=\"29\" height=\"14\" />\n</p><p>Counting all of these, we see that there are <img src=\"//latex.artofproblemsolving.com/c/7/f/c7f8bfe45411faee0a56234d13f58522bad5a40c.png\" class=\"latex\" alt=\"$\\boxed{155}$\" style=\"vertical-align: -5px\" width=\"39\" height=\"23\" /> numbers.\n</p><p>However, this is very slow and is prone to error.\n</p><p>~anabel.disher\n</p>\n<h2><span id=\"Solution_2_.28casework.29\"></span><span class=\"mw-headline\" id=\"Solution_2_(casework)\">Solution 2 (casework)</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/wiki/index.php?title=2013_CEMC_Euclid_Problems/Problem_4a&amp;action=edit&amp;section=3\" title=\"Edit section: Solution 2 (casework)\">edit</a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<p>The possible digits for the numbers would be <img src=\"//latex.artofproblemsolving.com/d/c/e/dce34f4dfb2406144304ad0d6106c5382ddd1446.png\" class=\"latex\" alt=\"$1$\" style=\"vertical-align: -1px\" width=\"11\" height=\"14\" />, <img src=\"//latex.artofproblemsolving.com/7/c/d/7cde695f2e4542fd01f860a89189f47a27143b66.png\" class=\"latex\" alt=\"$3$\" style=\"vertical-align: -1px\" width=\"11\" height=\"14\" />, <img src=\"//latex.artofproblemsolving.com/7/9/0/79069377f91364c2f87a64e5f9f562a091c8a6c1.png\" class=\"latex\" alt=\"$5$\" style=\"vertical-align: -1px\" width=\"11\" height=\"14\" />, <img src=\"//latex.artofproblemsolving.com/e/0/a/e0a0db32027a732ac57d37ef2ae9bb150f65b108.png\" class=\"latex\" alt=\"$7$\" style=\"vertical-align: -1px\" width=\"11\" height=\"14\" />, and <img src=\"//latex.artofproblemsolving.com/b/f/2/bf2c9074b396e3af0dea52d792660eea1c77f10f.png\" class=\"latex\" alt=\"$9$\" style=\"vertical-align: -1px\" width=\"11\" height=\"14\" />. We can break the problem up into cases based on how many digits there are.\n</p><p>Since the positive integer must be less than <img src=\"//latex.artofproblemsolving.com/6/e/e/6ee927e1332358c96c62c277441c907c4f51057f.png\" class=\"latex\" alt=\"$1000$\" style=\"vertical-align: -1px\" width=\"38\" height=\"14\" />, it must have <img src=\"//latex.artofproblemsolving.com/d/c/e/dce34f4dfb2406144304ad0d6106c5382ddd1446.png\" class=\"latex\" alt=\"$1$\" style=\"vertical-align: -1px\" width=\"11\" height=\"14\" />, <img src=\"//latex.artofproblemsolving.com/4/1/c/41c544263a265ff15498ee45f7392c5f86c6d151.png\" class=\"latex\" alt=\"$2$\" style=\"vertical-align: -1px\" width=\"11\" height=\"14\" />, or <img src=\"//latex.artofproblemsolving.com/7/c/d/7cde695f2e4542fd01f860a89189f47a27143b66.png\" class=\"latex\" alt=\"$3$\" style=\"vertical-align: -1px\" width=\"11\" height=\"14\" /> digits.\n</p><p>First, if it is a <img src=\"//latex.artofproblemsolving.com/d/c/e/dce34f4dfb2406144304ad0d6106c5382ddd1446.png\" class=\"latex\" alt=\"$1$\" style=\"vertical-align: -1px\" width=\"11\" height=\"14\" />-digit number, we realize that there are only <img src=\"//latex.artofproblemsolving.com/7/9/0/79069377f91364c2f87a64e5f9f562a091c8a6c1.png\" class=\"latex\" alt=\"$5$\" style=\"vertical-align: -1px\" width=\"11\" height=\"14\" /> because there are only <img src=\"//latex.artofproblemsolving.com/7/9/0/79069377f91364c2f87a64e5f9f562a091c8a6c1.png\" class=\"latex\" alt=\"$5$\" style=\"vertical-align: -1px\" width=\"11\" height=\"14\" /> odd numbers less than <img src=\"//latex.artofproblemsolving.com/f/c/6/fc606f7f1e530731ab4f1cc364c01dc64a4455ee.png\" class=\"latex\" alt=\"$10$\" style=\"vertical-align: -1px\" width=\"20\" height=\"14\" />.\n</p><p>Second, if it is a <img src=\"//latex.artofproblemsolving.com/4/1/c/41c544263a265ff15498ee45f7392c5f86c6d151.png\" class=\"latex\" alt=\"$2$\" style=\"vertical-align: -1px\" width=\"11\" height=\"14\" />-digit number, there are <img src=\"//latex.artofproblemsolving.com/7/9/0/79069377f91364c2f87a64e5f9f562a091c8a6c1.png\" class=\"latex\" alt=\"$5$\" style=\"vertical-align: -1px\" width=\"11\" height=\"14\" /> possible values for each digit, so there are <img src=\"//latex.artofproblemsolving.com/e/1/c/e1cb2b1216f6a5a6e9672c52b9cbe9349231f450.png\" class=\"latex\" alt=\"$5^{2} = 25$\" style=\"vertical-align: -1px\" width=\"61\" height=\"17\" /> possible values.\n</p><p>Last, if it is a <img src=\"//latex.artofproblemsolving.com/7/c/d/7cde695f2e4542fd01f860a89189f47a27143b66.png\" class=\"latex\" alt=\"$3$\" style=\"vertical-align: -1px\" width=\"11\" height=\"14\" />-digit number, there are <img src=\"//latex.artofproblemsolving.com/7/9/0/79069377f91364c2f87a64e5f9f562a091c8a6c1.png\" class=\"latex\" alt=\"$5$\" style=\"vertical-align: -1px\" width=\"11\" height=\"14\" /> possible values for each digit, so there are <img src=\"//latex.artofproblemsolving.com/e/a/3/ea39323929251906673ba7d0a72f3568b6680401.png\" class=\"latex\" alt=\"$5^{3} = 125$\" style=\"vertical-align: -1px\" width=\"70\" height=\"17\" /> possible values.\n</p><p>In total, there are <img src=\"//latex.artofproblemsolving.com/5/c/e/5cea4719746532b979fab3b403d4183fc45645a2.png\" class=\"latex\" alt=\"$5 + 25 + 125 = 30 + 125 = \\boxed{155}$\" style=\"vertical-align: -6px\" width=\"256\" height=\"25\" /> possible values\n</p><p>~anabel.disher\n</p>\n<!-- \nNewPP limit report\nCached time: 20261017232401\nCache expiry: 86400\nReduced expiry: false\nComplications: [show‐toc]\nCPU time usage: 0.054 seconds\nReal time usage: 0.068 seconds\nPreprocessor visited node count: 853/1000000\nPost‐expand include size: 78/2097152 bytes\nTemplate argument size: 0/2097152 bytes\nHighest expansion depth: 3/100\nExpensive parser function count: 0/100\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 29672/5000000 bytes\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%    6.171      1 2013_CEMC_Euclid_Problems/Problem_4\n100.00%    6.171      1 -total\n-->\n\n<!-- Saved in parser cache with key wiki-wiki_:pcache:36040:|#|:idhash:canonical and timestamp 20261017232401 and revision id 279722. Rendering was triggered because: api-parse\n -->\n</div>"}