i/index.php?title=2006_Cyprus_MO/Lyceum/Problem_14\" title=\"2006 Cyprus MO/Lyceum/Problem 14\">14</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_Cyprus_MO/Lyceum/Problem_15\" title=\"2006 Cyprus MO/Lyceum/Problem 15\">15</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_Cyprus_MO/Lyceum/Problem_16\" title=\"2006 Cyprus MO/Lyceum/Problem 16\">16</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_Cyprus_MO/Lyceum/Problem_17\" title=\"2006 Cyprus MO/Lyceum/Problem 17\">17</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_Cyprus_MO/Lyceum/Problem_18\" title=\"2006 Cyprus MO/Lyceum/Problem 18\">18</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_Cyprus_MO/Lyceum/Problem_19\" title=\"2006 Cyprus MO/Lyceum/Problem 19\">19</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_Cyprus_MO/Lyceum/Problem_20\" title=\"2006 Cyprus MO/Lyceum/Problem 20\">20</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_Cyprus_MO/Lyceum/Problem_21\" title=\"2006 Cyprus MO/Lyceum/Problem 21\">21</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_Cyprus_MO/Lyceum/Problem_22\" title=\"2006 Cyprus MO/Lyceum/Problem 22\">22</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_Cyprus_MO/Lyceum/Problem_23\" title=\"2006 Cyprus MO/Lyceum/Problem 23\">23</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_Cyprus_MO/Lyceum/Problem_24\" title=\"2006 Cyprus MO/Lyceum/Problem 24\">24</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_Cyprus_MO/Lyceum/Problem_25\" title=\"2006 Cyprus MO/Lyceum/Problem 25\">25</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_Cyprus_MO/Lyceum/Problem_26\" title=\"2006 Cyprus MO/Lyceum/Problem 26\">26</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_Cyprus_MO/Lyceum/Problem_27\" title=\"2006 Cyprus MO/Lyceum/Problem 27\">27</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_Cyprus_MO/Lyceum/Problem_28\" title=\"2006 Cyprus MO/Lyceum/Problem 28\">28</a> <b>•</b> <a href=\"/wiki/index.php?title=2006_Cyprus_MO/Lyceum/Problem_29\" title=\"2006 Cyprus MO/Lyceum/Problem 29\">29</a> <b>•</b