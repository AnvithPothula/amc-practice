\"/wiki/index.php?title=2004_AMC_12B_Problems/Problem_22\" title=\"2004 AMC 12B Problems/Problem 22\">22</a> <b>•</b> <a href=\"/wiki/index.php?title=2004_AMC_12B_Problems/Problem_23\" title=\"2004 AMC 12B Problems/Problem 23\">23</a> <b>•</b> <a href=\"/wiki/index.php?title=2004_AMC_12B_Problems/Problem_24\" title=\"2004 AMC 12B Problems/Problem 24\">24</a> <b>•</b> <a href=\"/wiki/index.php?title=2004_AMC_12B_Problems/Problem_25\" title=\"2004 AMC 12B Problems/Problem 25\">25</a>\n</td></tr>\n<tr>\n<td colspan=\"2\" style=\"text-align:center;\"><b><a href=\"/wiki/index.php?title=AMC_12_Problems_and_Solutions\" title=\"AMC 12 Problems and Solutions\"> All AMC 12 Problems and Solutions</a></b>\n</td></tr></tbody></table>\n<table class=\"wikitable\" style=\"margin:0.5em auto; font-size:95%; border:1px solid black; width:80%;\">\n<tbody><tr>\n<td style=\"background:#ccf;text-align:center;\" colspan=\"3\"><b><a href=\"/wiki/index.php?title=2004_AMC_10B\" title=\"2004 AMC 10B\">2004 AMC 10B</a></b> (<b><a href=\"/wiki/index.php?title=2004_AMC_10B_Problems\" title=\"2004 AMC 10B Problems\">Problems</a></b> • <b><a href=\"/wiki/index.php?title=2004_AMC_10B_Answer_Key\" title=\"2004 AMC 10B Answer Key\">Answer Key</a></b> • <a rel=\"nofollow\" class=\"external text\" href=\"https://artofproblemsolving.com/community/c13\">Resources</a>)\n</td></tr>\n<tr>\n<td width=\"50%\" align=\"center\" rowspan=\"1\">Preceded&#160;by<br /><b><a href=\"/wiki/index.php?title=2004_AMC_10B_Problems/Problem_11\" title=\"2004 AMC 10B Problems/Problem 11\">Problem 11</a></b>\n</td>\n<td width=\"50%\" align=\"center\" rowspan=\"1\">Followed&#160;by<br /><b><a href=\"/wiki/index.php?title=2004_AMC_10B_Problems/Problem_13\" title=\"2004 AMC 10B Problems/Problem 13\">Problem 13</a></b>\n</td></tr>\n<tr>\n<td colspan=\"3\" style=\"text-align:center;\"><a href=\"/wiki/index.php?title=2004_AMC_10B_Problems/Problem_1\" title=\"2004 AMC 10B Problems/Problem 1\">1</a> <b>•</b> <a href=\"/wiki/index.php?t